module genesis
//! The cartridge: its ROM, its save RAM, and the Sega mapper some carry — what the 68000
//! sees at 000000–3FFFFF and at the mapper's registers, A130F1–A130FF.
//!
//! **Told apart by the header**, as BlastEm tells them (its romdb.c's heuristics; the
//! comparison is `tests/vdp.sh`'s cartridge ROMs):
//!
//! - **The ROM** ends where the header's ROM end (1A4) says — or the file's size, if that is
//!   longer — and is mirrored through 4 MB at its size rounded up to a power of two.
//! - **Save RAM** is declared by "RA" at 1B0, its bus at 1B2 (bits 4–3: 11 the odd bytes,
//!   10 the even, 00 both) and its first and last addresses at 1B4 and 1B8. On one bus it
//!   holds a byte per two addresses, the other half reading FF. Past the ROM's end it is
//!   mapped for good; over the ROM (a ROM of more than 2 MB) it is the Sega mapper's to
//!   switch in, at 200000–3FFFFF: register A130F1's bit 0 maps it for reading, and writes
//!   reach it only with bit 1 (protect) clear.
//! - **The SSF2 mapper**: a file of more than 4 MB whose header says 4 MB or less. Region
//!   0 (000000–07FFFF) is fixed; A130F3, F5 … FF choose the 512 KB bank each of regions 1–7
//!   shows, from power-on showing their own. A130F1's bit 0 there maps save RAM over regions
//!   4–7 instead.
//!
//! **A ROM file is a raw image or an SMD one** ([rom_image]), told apart by the SMD copier's
//! header, as BlastEm tells them: 512 bytes whose bytes 1, 8 and 9 are 03 AA BB and 3–7 are
//! zero. Then the ROM follows in 16 KB blocks, each the odd addresses' bytes and then the
//! even addresses' (a short last block split at its own half). The file's name is not
//! consulted: `.bin`, `.gen` and `.md` files that are SMD images inside are common.
//!
//! **An MGD image** (the Multi Game Doctor's, usually `.md`) has no header: the whole file
//! is one block laid out as an SMD block is, the odd addresses' bytes and then the even
//! addresses'. So it is told apart by content: a file that is not SMD and does not read
//! "SEGA" at 100 as it is, but does once put back in address order, is MGD — which also
//! settles the order, since the other would read "ESAG". A file that reads "SEGA" neither
//! way (a few unlicensed games leave it out) is taken as raw.
//!
//! **A split SMD image** is a game too big for the copier's disk, in parts: each an SMD
//! file with its own header, byte 2 set (40) in every part but the last, and the ROM their
//! blocks in turn. BlastEm refuses them, so there is no reference to hold them to beyond
//! the format; the front end finds the parts after the first by their names
//! ([next_part_path]), or is given them.
//!
//! **A zip archive holds the files** ([roms_in_zip]): the ROM in it — the one file with a
//! ROM's extension (`.bin`, `.gen`, `.md`, `.smd`, a numbered part), or the one file if
//! none has — or a split SMD image's parts, found from the first by their names as on
//! disk. An archive holding several ROMs is refused, naming them, rather than one picked.
//!
//! **Not here**: the serial EEPROMs some cartridges carry (no header declares them — BlastEm
//! finds them in a database), the lock-on and unlicensed mappers. The Z80's bank window
//! reads the ROM as it lies, not through the mapper.

import std.zip.{ ZipEntry, zip_entries, unzip }
import std.path

/// Save RAM's buses.
pub const SAVE_NONE: u8 = 0
pub const SAVE_ODD: u8 = 1
pub const SAVE_EVEN: u8 = 2
pub const SAVE_BOTH: u8 = 3

/// The mappers.
const PLAIN: u8 = 0
const SEGA_SRAM: u8 = 1
const SSF2: u8 = 2

pub struct Cartridge {
  rom: []u8,
  /// The ROM mirrors at `rom_mask + 1`, and is mapped below `rom_limit`.
  rom_mask: i64,
  rom_limit: i64,
  /// The SSF2 mapper's banks wrap at the ROM's size rounded up to a power of two.
  bank_mask: i64,
  mapper: u8,
  /// The mapper's registers: 0 the save RAM control, 1–7 the regions' banks.
  banks: [8]u8,
  /// Save RAM: its bus, where it starts and its address mask, its bytes (one per address
  /// on one bus, two per word on both), and whether it has been written since last saved.
  save_bus: u8,
  save_start: i64,
  save_mask: i64,
  save: []u8,
  save_dirty: bool,
}

/// The ROM image in a dump's files, in order: one file for a raw, SMD or MGD image, or the
/// parts of a split SMD image — each an SMD file of its own, byte 2 set in all but the
/// last. An SMD or MGD image is put back in address order, a raw image kept as it is. An
/// error says what is wrong with the parts.
pub let rom_image = pure (files: [][]u8) -> Result<[]u8, string> => {
  if files.len() == 0 { return Err("no file given") }
  if !is_smd(files[0]) {
    if files.len() > 1 { return Err("given in parts, but its first is not an SMD file") }
    return Ok(raw_or_mgd(files[0]))
  }
  var rom: []u8 = []
  for n, file in files {
    let last = n == files.len() - 1
    if !is_smd(file) { return Err("part ${n + 1} of a split SMD image is not an SMD file") }
    if last && file[2] != 0 {
      return Err("a split SMD image whose part ${n + 2} is missing (another follows part ${n + 1})")
    }
    if !last && file[2] == 0 {
      return Err("a split SMD image ending at part ${n + 1}, but more parts follow it")
    }
    for b in smd_rom(file) { rom.push(b) }
  }
  if files.len() > 1 && !says_sega(rom) {
    return Err("a split SMD image given from a later part than its first (no \"SEGA\" at 100)")
  }
  Ok(rom)
}

/// Whether a file is a part of a split SMD image with more parts after it.
pub let is_split_part = pure (file: []u8) -> bool => is_smd(file) && file[2] != 0

/// The name the next part of a split SMD image has, guessed from this part's by the three
/// ways copiers and dumpers number them: the extension (`game.1`, `game.001`); failing
/// that, the digits the name ends in (`sf2md1.smd`); failing that, the letter it ends in
/// (`sf2a.smd`). `None` when none of them can be counted on.
pub let next_part_path = pure (path: string) -> Maybe<string> => {
  let runes = path.to_runes()
  var base = 0
  var dot = -1
  for i, c in runes {
    if c == '/' {
      base = i + 1
      dot = -1
    } else if c == '.' && i > base {
      dot = i
    }
  }
  let stem_end = if dot >= 0 { dot } else { runes.len() }
  if dot >= 0 && dot + 1 < runes.len() && all_digits(runes, dot + 1, runes.len()) {
    return Some(counted_on(path, runes, dot + 1, runes.len()))
  }
  var digits = stem_end
  for digits > base && is_digit(runes[digits - 1]) { digits -= 1 }
  if digits < stem_end { return Some(counted_on(path, runes, digits, stem_end)) }
  if stem_end == base { return None }
  let c = runes[stem_end - 1]
  if !(c >= 'a' && c < 'z') && !(c >= 'A' && c < 'Z') { return None }
  Some(path.slice(0, stem_end - 1) ++ "${rune(i64(c) + 1)}" ++ path.slice(stem_end, runes.len()))
}

/// The ROM files a zip archive holds, as [rom_image] takes them: the one ROM, or a split
/// SMD image's parts in order.
pub let roms_in_zip = pure (archive: []u8) -> Result<[][]u8, string> => {
  let entries = zip_entries(archive)?
  var files: []ZipEntry = []
  for entry in entries {
    if !entry.is_directory() { files.push(entry) }
  }
  var roms: []ZipEntry = []
  for entry in files {
    if looks_like_rom(entry.name) { roms.push(entry) }
  }
  if roms.len() == 0 { roms = files }
  if roms.len() == 0 { return Err("an archive with no files in it") }
  if roms.len() == 1 { return Ok([unzip(archive, roms[0])?]) }
  // Several: a split image's parts, if the first by name leads through all of them.
  let by_name = roms.sorted_by((a, b) => a.name <=> b.name)
  var parts: [][]u8 = [unzip(archive, by_name[0])?]
  var name = by_name[0].name
  for parts.len() < by_name.len() && is_split_part(parts[parts.len() - 1]) {
    let Some(next) = next_part_path(name) else { break }
    var found = false
    for entry in by_name {
      if entry.name == next {
        parts.push(unzip(archive, entry)?)
        found = true
      }
    }
    if !found { break }
    name = next
  }
  if parts.len() == by_name.len() { return Ok(parts) }
  Err("an archive of several ROMs (${by_name.map((e) => e.name).join(", ")}); unzip the one to play")
}

/// Whether a file's name says it is a ROM, or one part of one.
let looks_like_rom = pure (name: string) -> bool => {
  let Some(ext) = name.extension() else { return false }
  let lower = ext.to_ascii_lower()
  lower == "bin" || lower == "gen" || lower == "md" || lower == "smd" || all_digits(ext.to_runes(), 0, ext.len())
}

const SMD_HEADER: i64 = 512
const SMD_BLOCK: i64 = 0x4000

/// Whether a file begins with the SMD copier's header.
let is_smd = pure (file: []u8) -> bool => {
  if file.len() <= SMD_HEADER || file[1] != 0x03 || file[8] != 0xAA || file[9] != 0xBB {
    return false
  }
  for i in 3..<8 {
    if file[i] != 0 { return false }
  }
  true
}

/// A file with no header as the ROM it holds: as it is if it reads "SEGA" so, put back in
/// address order if it reads "SEGA" only then (MGD), and as it is if neither.
let raw_or_mgd = pure (file: []u8) -> []u8 => {
  if says_sega(file) || file.len() % 2 != 0 { return file }
  let rom = interleaved(file, 0, file.len())
  if says_sega(rom) { rom } else { file }
}

/// An SMD file's ROM, its blocks put back in address order.
let smd_rom = pure (file: []u8) -> []u8 => {
  let size = file.len() - SMD_HEADER
  var rom: []u8 = [0; size]
  var block = 0
  for block < size {
    let length = if size - block < SMD_BLOCK { size - block } else { SMD_BLOCK }
    let part = interleaved(file, SMD_HEADER + block, length)
    for i in 0..<length { rom[block + i] = part[i] }
    block += SMD_BLOCK
  }
  rom
}

/// The `length` bytes of `file` from `from`, the odd addresses' and then the even
/// addresses', put back in address order.
let interleaved = pure (file: []u8, from: i64, length: i64) -> []u8 => {
  let half = length / 2
  var out: []u8 = [0; length]
  for i in 0..<half {
    out[2 * i] = file[from + half + i]
    out[2 * i + 1] = file[from + i]
  }
  out
}

/// Whether a ROM's header begins "SEGA" (at 100, or 101 after a space), as TMSS asks.
let says_sega = pure (rom: []u8) -> bool => {
  if rom.len() < 0x105 { return false }
  let at = if rom[0x100] == 0x20 { 0x101 } else { 0x100 }
  rom[at] == 0x53 && rom[at + 1] == 0x45 && rom[at + 2] == 0x47 && rom[at + 3] == 0x41
}

let is_digit = pure (c: rune) -> bool => c >= '0' && c <= '9'

let all_digits = pure (runes: []rune, from: i64, to: i64) -> bool => {
  for i in from..<to {
    if !is_digit(runes[i]) { return false }
  }
  true
}

/// `path` with the number at runes `from..<to` one more, kept as wide (`009` → `010`).
let counted_on = pure (path: string, runes: []rune, from: i64, to: i64) -> string => {
  var n: i64 = 0
  for i in from..<to { n = n * 10 + (i64(runes[i]) - i64('0')) }
  path.slice(0, from) ++ "${n + 1}".pad_start(to - from, "0") ++ path.slice(to, runes.len())
}

/// A cartridge from a ROM image, its header read.
pub let new_cartridge = pure (rom: []u8) -> Cartridge => {
  let size = rom.len()
  var rom_end = header_long(rom, 0x1A4) + 1
  let header_end = rom_end
  if size > rom_end {
    rom_end = size
  } else if rom_end > power_of_two(size) {
    rom_end = power_of_two(size)
  }
  var cart = Cartridge {
    rom: rom,
    rom_mask: if rom_end < 0x400000 { power_of_two(rom_end) - 1 } else { 0xFFFFFF },
    rom_limit: 0x400000,
    bank_mask: power_of_two(size) - 1,
    mapper: PLAIN,
    banks: #[0, 1, 2, 3, 4, 5, 6, 7],
    save_bus: SAVE_NONE,
    save_start: 0,
    save_mask: 0,
    save: [],
    save_dirty: false,
  }
  let has_save = size >= 0x1BC && rom[0x1B0] == 0x52 && rom[0x1B1] == 0x41
  if has_save {
    let declared = declared_save(rom)
    cart.save_bus = declared.bus
    cart.save_start = declared.start
    cart.save_mask = declared.mask
    cart.save = declared.bytes
  }
  if size > 0x400000 && header_end <= 0x400000 {
    cart.mapper = SSF2
    return cart
  }
  if !has_save { return cart }
  if cart.save_start >= 0x800000 {
    cart.save_bus = SAVE_NONE
    return cart
  }
  if cart.save_start >= rom_end {
    let top = if rom_end < 0x400000 { power_of_two(rom_end) - 1 } else { 0xFFFFFF }
    cart.rom_limit = if top > cart.save_start { cart.save_start } else { top + 1 }
  } else {
    cart.mapper = SEGA_SRAM
  }
  cart
}

/// Save RAM as a header declares it.
struct SaveRam {
  bus: u8,
  start: i64,
  mask: i64,
  bytes: []u8,
}

/// The save RAM the header declares: its bus, range and (zeroed) bytes — none for a range
/// beyond the 68000's cartridge space.
let declared_save = pure (rom: []u8) -> SaveRam => {
  let flags = rom[0x1B2] & 0x18
  let bus = if flags == 0x18 { SAVE_ODD } else if flags == 0x10 { SAVE_EVEN } else { SAVE_BOTH }
  let start = header_long(rom, 0x1B4) & 0xFFFFFE
  let mask = (header_long(rom, 0x1B8) | 1) - start
  let size = if bus == SAVE_BOTH { mask + 1 } else { (mask + 1) / 2 }
  let bytes: []u8 = if start < 0x800000 && size > 0 && size <= 0x100000 { [0; size] } else { [] }
  SaveRam { bus: bus, start: start, mask: mask, bytes: bytes }
}

/// A byte of 000000–3FFFFF as the 68000 reads it.
pub let cart_read = pure (cart: ref Cartridge, a: i64) -> u8 => {
  if cart.save.len() > 0 && save_mapped(cart, a) { return save_read(cart, a) }
  if a >= cart.rom_limit { return 0xFF }
  var at = a & cart.rom_mask
  if cart.mapper == SSF2 && (a >> 19) != 0 {
    // A region's bank, within the ROM's size rounded up to a power of two.
    at = ((i64(cart.banks[a >> 19]) << 19) & cart.bank_mask) | (a & 0x7FFFF)
  }
  if at < cart.rom.len() { cart.rom[at] } else { 0 }
}

/// A byte the 68000 writes to 000000–3FFFFF: only save RAM takes it.
pub let cart_write = (cart: mut Cartridge, a: i64, value: u8) -> void => {
  if cart.save.len() == 0 || !save_mapped(cart, a) { return }
  if cart.mapper != PLAIN && (cart.banks[0] & 3) != 1 { return }
  let offset = (a - cart.save_start) & cart.save_mask
  let at = match cart.save_bus {
    1 => if (offset & 1) == 1 { offset >> 1 } else { -1 },
    2 => if (offset & 1) == 0 { offset >> 1 } else { -1 },
    _ => offset,
  }
  if at >= 0 && at < cart.save.len() {
    cart.save[at] = value
    cart.save_dirty = true
  }
}

/// A byte written to the mapper's registers, A130F0–A130FF: on the odd addresses, the
/// register (address & 0E) / 2.
pub let cart_register = (cart: mut Cartridge, a: i64, value: u8) -> void => {
  if cart.mapper == PLAIN || (a & 1) == 0 { return }
  let r = (a & 0x0E) >> 1
  if r == 0 || cart.mapper == SSF2 { cart.banks[r] = value }
}

/// Whether save RAM, rather than ROM, answers at `a`: past the ROM for good, or where the
/// mapper has switched it in.
let save_mapped = pure (cart: ref Cartridge, a: i64) -> bool => {
  match cart.mapper {
    0 => a >= cart.save_start && a <= cart.save_start + cart.save_mask,
    1 => a >= 0x200000 && (cart.banks[0] & 1) != 0,
    _ => a >= 0x200000 && (cart.banks[0] & 1) != 0,
  }
}

/// A byte of save RAM: on one bus, the other half of each word reads FF.
let save_read = pure (cart: ref Cartridge, a: i64) -> u8 => {
  let offset = (a - cart.save_start) & cart.save_mask
  let at = match cart.save_bus {
    1 => if (offset & 1) == 1 { offset >> 1 } else { -1 },
    2 => if (offset & 1) == 0 { offset >> 1 } else { -1 },
    _ => offset,
  }
  if at >= 0 && at < cart.save.len() { cart.save[at] } else { 0xFF }
}

/// Save RAM's bytes, as a save file holds them (BlastEm's `save.sram` too): one per byte of
/// RAM, in address order.
pub let save_bytes = pure (cart: ref Cartridge) -> []u8 => cart.save

/// Save RAM restored from a save file; a file of another size is not this cartridge's and
/// is ignored.
pub let load_save = (cart: mut Cartridge, bytes: []u8) -> bool => {
  if bytes.len() != cart.save.len() || bytes.len() == 0 { return false }
  cart.save = bytes
  cart.save_dirty = false
  true
}

let header_long = pure (rom: []u8, at: i64) -> i64 => {
  if at + 3 >= rom.len() { return 0 }
  (i64(rom[at]) << 24) | (i64(rom[at + 1]) << 16) | (i64(rom[at + 2]) << 8) | i64(rom[at + 3])
}

let power_of_two = pure (n: i64) -> i64 => {
  var p: i64 = 1
  for p < n { p = p * 2 }
  p
}
