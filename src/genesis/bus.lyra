module genesis
//! The Genesis as a composition: the 68000's view of the machine — cartridge ROM, work RAM,
//! the VDP's ports — wired as the console wires them. A chip is a module (`m68k`, `vdp`);
//! this is where they meet (CLAUDE.md's rule).
//!
//! **What is here is what a game needs to run without sound**: ROM at 000000–3FFFFF, work
//! RAM at E00000–FFFFFF (64 KB, mirrored), the VDP at C00000–C0001F, the I/O chip with two
//! 3- or 6-button pads (`io.lyra`), the Z80 and its side of the machine (`sound.lyra`), and the
//! TMSS register taking its write. No wait states, no sound chips, no cartridge hardware
//! (EEPROM, lock-on) yet — the cartridge's ROM, save RAM and Sega mapper are
//! `cartridge.lyra`'s.
//!
//! **Time is the master clock**, ≈53.69 MHz, kept here: a 68000 cycle is 7 of it, and an
//! access its four cycles. The VDP's beam is caught up to it whenever the 68000 is about to
//! see the VDP — a port access (as its bus cycle ends), the interrupt pins it samples at
//! every fetch — so what the 68000 sees is where the beam stands then. **The VDP can hold
//! the 68000**: a write to a full FIFO, a read not yet fetched, and a 68000 → VDP transfer,
//! for which the bus feeds the VDP from its own memory, slot by slot, the 68000 off it; the
//! clock then moves on to where the VDP lets go, in whole 68000 cycles.
//!
//! **DRAM refresh** takes 2 cycles in every 128 of the 68000's (BlastEm's figure, which it
//! applies approximately, at its synchronisation points; here at every access and idle).

import m68k.{ Bus }
import z80.{ Z80Cpu, new_z80, reset_z80, step as z80_step }
import vdp.{
  Vdp,
  new_vdp,
  write_control,
  write_data,
  read_data,
  read_status,
  dma_68k_running,
  dma_68k_done,
  dma_source,
  step_slot,
  round_up,
  run_beam,
  hv_counter,
  vdp_interrupt_level,
  acknowledge_vdp
}

/// The machine's memory map, as the 68000 reaches it.
pub struct GenesisBus {
  /// The cartridge: its ROM, save RAM and mapper (`cartridge.lyra`).
  cart: Cartridge,
  /// 64 KB of work RAM.
  ram: []u8,
  vdp: Vdp,
  /// The master clock: time since power-on.
  clock: i64,
  /// Master clocks since the last refresh.
  refresh: i64,
  /// The last word the 68000's data bus carried, which a read of an undriven line (the
  /// status register's top six bits) returns.
  open_bus: u16,
  /// The controller ports (1, 2, expansion), and the buttons held on the pads in the first
  /// two — the front end's to set, a `PAD_*` mask each. Both hold 6-button pads, as most
  /// players' do; [set_pads] changes that.
  ports: [3]Port,
  pads: [2]u16,
  /// The Z80, and what it is wired to — run on at every 68000 bus cycle ([run_z80]).
  z80: Z80Cpu,
  sound: Z80Side,
}

/// Master clocks per 68000 cycle.
pub const CPU_CLOCKS: i64 = 7

/// 68000 cycles between refreshes, and the cycles a refresh takes.
const REFRESH_INTERVAL: i64 = 128 * CPU_CLOCKS
const REFRESH_DELAY: i64 = 2 * CPU_CLOCKS

/// The version register's value: an overseas (US) NTSC console with no expansion unit and
/// no TMSS — version 0, so a ROM that checks for TMSS writes nothing to it.
const VERSION: u8 = 0xA0

/// A machine with `rom` in the cartridge slot and everything else at power-on.
pub let genesis_bus = pure (rom: []u8) -> GenesisBus => GenesisBus {
  cart: new_cartridge(rom),
  ram: [0; 65536],
  vdp: new_vdp(),
  clock: 0,
  refresh: 0,
  open_bus: 0,
  ports: #[new_port(true), new_port(true), new_port(false)],
  pads: #[0, 0],
  z80: new_z80(),
  sound: new_z80_side(rom),
}

impl GenesisBus {
  /// The kind of pad in ports 1 and 2: 6-button, or the original 3 (which a few early games
  /// need, misreading a 6-button pad).
  pub let set_pads = (self: mut, six_button: bool) -> void => {
    self.ports[0] = new_port(six_button)
    self.ports[1] = new_port(six_button)
  }

  /// Run the machine's clock on to master clock `to`, the VDP with it — for a caller that has
  /// nothing for the 68000 to do meanwhile.
  pub let run_vdp_to = (self: mut, to: i64) -> void => run_beam(self.vdp, to)
}

impl Bus for GenesisBus {
  read_word = (self, addr, fc) => {
    let a = addr & 0xFFFFFF
    self.tick(4)
    let word = if a >= 0xC00000 && a < 0xC00020 { self.read_vdp(a) } else { self.peek_word(a) }
    self.open_bus = word
    word
  }
  read_byte = (self, addr, fc) => {
    let a = addr & 0xFFFFFF
    // A byte of a VDP port is a word access to it: the port acts once, and the byte
    // is the half the address names.
    self.tick(4)
    if a >= 0xA04000 && a < 0xA06000 {
      let status = read_z80_fm(self, a)
      self.open_bus = (u16(status) << 8) | u16(status)
      return status
    }
    let word = if a >= 0xC00000 && a < 0xC00020 { self.read_vdp(a & 0xFFFFFE) } else { self.peek_word(a & 0xFFFFFE) }
    self.open_bus = word
    if (a & 1) == 0 { u8(word >> 8) } else { u8(word & 0xFF) }
  }
  write_word = (self, addr, fc, value) => {
    let a = addr & 0xFFFFFF
    self.tick(4)
    if a >= 0xE00000 {
      let at = i64(a & 0xFFFE)
      self.ram[at] = u8(value >> 8)
      self.ram[at + 1] = u8(value & 0xFF)
    } else if a < 0x400000 {
      cart_write(self.cart, i64(a & 0x3FFFFE), u8(value >> 8))
      cart_write(self.cart, i64(a & 0x3FFFFE) + 1, u8(value & 0xFF))
    } else if a >= 0xC00000 && a < 0xC00010 {
      self.write_vdp(a, value)
    } else if a >= 0xC00010 && a < 0xC00018 {
      // A word to the PSG's port: its low byte.
      self.sound.write_sn(self.clock, u8(value & 0xFF))
    } else {
      self.write_other(a & 0xFFFFFE, u8(value >> 8))
      self.write_other(a | 1, u8(value & 0xFF))
    }
    self.open_bus = value
  }
  write_byte = (self, addr, fc, value) => {
    let a = addr & 0xFFFFFF
    // A byte written is on both halves of the data bus.
    let word = (u16(value) << 8) | u16(value)
    self.tick(4)
    if a >= 0xE00000 {
      self.ram[i64(a & 0xFFFF)] = value
    } else if a < 0x400000 {
      cart_write(self.cart, i64(a), value)
    } else if a >= 0xC00000 && a < 0xC00010 {
      // A byte written to a VDP port is that byte in both halves of a word.
      self.write_vdp(a & 0xFFFFFE, word)
    } else if a >= 0xC00010 && a < 0xC00018 {
      // The PSG, at the odd bytes C00011–C00017.
      if (a & 1) == 1 { self.sound.write_sn(self.clock, value) }
    } else {
      self.write_other(a, value)
    }
    self.open_bus = word
  }
  test_and_set_byte = (self, addr, fc) => {
    // The Genesis never completes TAS's write: the read-modify-write cycle is not one its
    // bus arbiter supports, so only the read happens.
    let a = addr & 0xFFFFFF
    let word = self.peek_word(a & 0xFFFFFE)
    self.tick(10)
    self.open_bus = word
    if (a & 1) == 0 { u8(word >> 8) } else { u8(word & 0xFF) }
  }
  interrupt_level = (self) => {
    run_beam(self.vdp, self.clock)
    vdp_interrupt_level(self.vdp)
  }
  acknowledge_interrupt = (self, level) => {
    run_beam(self.vdp, self.clock)
    acknowledge_vdp(self.vdp)
    // The Genesis answers every acknowledge with VPA — autovectored, as a 6800-style
    // cycle, which waits for the E clock (a tenth of the 68000's): 5 cycles more than an
    // ordinary bus cycle, and up to 9 more for E's phase. (BlastEm's figures, from its
    // measurements: 9–18 cycles in all.)
    self.tick(4)
    self.tick(5 + (self.clock / CPU_CLOCKS) % 10)
    24 + u32(level)
  }
  idle = (self, n) => self.tick(i64(n))
}

impl GenesisBus {
  /// `n` 68000 cycles pass, and the refreshes due in them; the Z80 runs on to the same time.
  let tick = (self: mut, n: i64) -> void => {
    self.clock += n * CPU_CLOCKS
    self.refresh += n * CPU_CLOCKS
    while self.refresh >= REFRESH_INTERVAL {
      self.refresh -= REFRESH_INTERVAL
      self.clock += REFRESH_DELAY
    }
    self.run_z80()
  }

  /// Run the Z80 on to the master clock — instruction by instruction, so it may end a little
  /// past it — unless the 68000 holds its bus or its reset line, when its time passes idle.
  /// Its /INT follows the VDP, which is run on first.
  let run_z80 = (self: mut) -> void => {
    if self.sound.clock >= self.clock { return }
    if self.sound.in_reset || self.sound.bus_requested {
      self.sound.clock += round_up(self.clock - self.sound.clock, Z80_CLOCKS)
      return
    }
    run_beam(self.vdp, self.clock)
    self.sound.int_from = self.vdp.z80_int_at
    var cpu = self.z80
    while self.sound.clock < self.clock { z80_step(cpu, self.sound) }
    self.z80 = cpu
  }

  /// The word at an even address outside the VDP, with no bus cycle: ROM, work RAM, the Z80's
  /// space, the I/O chip (its byte in both halves), the Z80 bus request. Also what a
  /// 68000 → VDP DMA reads, which is why it takes no time here.
  let peek_word = pure (self: ref, a: u32) -> u16 => {
    if a < 0x400000 {
      let at = i64(a & 0x3FFFFE)
      return (u16(cart_read(self.cart, at)) << 8) | u16(cart_read(self.cart, at + 1))
    }
    if a >= 0xE00000 {
      let at = i64(a & 0xFFFE)
      return (u16(self.ram[at]) << 8) | u16(self.ram[at + 1])
    }
    if a >= 0xA00000 && a < 0xA10000 {
      return (u16(read_z80_space(self, a)) << 8) | u16(read_z80_space(self, a | 1))
    }
    if a >= 0xA10000 && a < 0xA10020 {
      let byte = read_io(self, a)
      return (u16(byte) << 8) | u16(byte)
    }
    if a == 0xA11100 { return u16(read_bus_request(self)) << 8 }
    0
  }

  /// A byte written outside RAM and the VDP: into the Z80's space, the I/O chip, or the Z80's
  /// bus request and reset lines (A11100 and A11200, bit 0 of the even byte: 1 requests the
  /// bus; 0 holds the Z80 in reset, 1 lets it run). The TMSS register (A14000)
  /// takes its write and changes nothing, as this console has no TMSS.
  let write_other = (self: mut, a: u32, value: u8) -> void => {
    if a >= 0xA00000 && a < 0xA10000 {
      write_z80_space(self, a, value)
    } else if a >= 0xA10000 && a < 0xA10020 {
      write_io(self, a, value)
    } else if a >= 0xA130F0 && a < 0xA13100 {
      cart_register(self.cart, i64(a), value)
    } else if a == 0xA11100 {
      let requested = (value & 1) != 0
      // The Z80 resumes a T-state after its bus is given back (BlastEm's figure).
      if self.sound.bus_requested && !requested { self.sound.clock += Z80_CLOCKS }
      self.sound.bus_requested = requested
    } else if a == 0xA11200 {
      self.sound.in_reset = (value & 1) == 0
      if self.sound.in_reset { reset_z80(self.z80) }
    }
  }

  /// A word read from the VDP's ports, the beam caught up first: data (C00000–03), control
  /// (C00004–07), HV counter (C00008–0F).
  let read_vdp = (self: mut, a: u32) -> u16 => {
    run_beam(self.vdp, self.clock)
    let word = match (a >> 2) & 7 {
      0 => read_data(self.vdp, self.clock),
      1 => read_status(self.vdp, self.open_bus),
      _ => hv_counter(self.vdp),
    }
    self.held_by_vdp()
    word
  }

  /// A word written to the VDP's ports, the beam caught up first. A control write may start a
  /// 68000 → VDP transfer, which the bus feeds from its own memory, a word for each slot that
  /// takes one, until it ends.
  let write_vdp = (self: mut, a: u32, value: u16) -> void => {
    run_beam(self.vdp, self.clock)
    match (a >> 2) & 7 {
      0 => write_data(self.vdp, value, self.clock),
      1 => {
        if write_control(self.vdp, value, self.clock) {
          while dma_68k_running(self.vdp) {
            self.vdp.dma_word = self.peek_word(dma_source(self.vdp) & 0xFFFFFE)
            step_slot(self.vdp)
          }
          dma_68k_done(self.vdp)
        }
      },
      _ => {},
    }
    self.held_by_vdp()
  }

  /// The 68000 goes on where the VDP let it, in whole cycles.
  let held_by_vdp = (self: mut) -> void => {
    let until = self.vdp.resume_at
    if until > self.clock { self.clock += round_up(until - self.clock, CPU_CLOCKS) }
  }
}
