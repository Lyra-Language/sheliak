module psg
//! The SN76489 programmable sound generator — the Genesis's PSG (inside its VDP), and the
//! Master System's and Game Gear's sound chip: three square-wave tone channels and a noise
//! channel, each with a 4-bit attenuation.
//!
//! **Its state is what is modelled and checked**, tick by tick: each channel's counter and
//! output, the noise shift register, the attenuations (`tests/psg.sh`, against BlastEm's
//! PSG run as a separate program). How loud an attenuation is — 2 dB a step, 15 silent —
//! is [level]'s, and the mixing the front end's.
//!
//! **What was settled**: a tick comes every 16 input clocks (the Genesis feeds it the
//! Z80's, so 240 master clocks). A tone counter counts down each tick and, reaching zero,
//! reloads its period and flips the channel's output — so periods 0 and 1 both flip every
//! tick. The noise channel's counter does the same with its own period (16, 32, 64, or
//! tone 3's), and each time its output rises the shift register steps: its bit 0 is the
//! noise output, it rotates right, and for white noise bit 15 takes bit 0 XOR bit 3 (the
//! Sega variant's taps; periodic noise just rotates). Writing the noise register resets the
//! register to 8000.
//!
//! **Where the documents part**: a data byte (bit 7 clear) written while a volume or noise
//! register is latched sets that register's low 4 bits on the hardware (SMS Power's tests);
//! BlastEm ignores it. Sheliak follows the hardware, and the comparison avoids the case.

/// The PSG's registers and counters.
pub struct Psg {
  /// The tone periods (10 bits) of channels 0–2, and the noise control (3 bits) in 3.
  period: [4]u16,
  /// Attenuation per channel, 0 (loudest) to 15 (off).
  volume: [4]u8,
  /// The counters, counting down to a flip.
  counter: [4]u16,
  /// Each channel's square wave: its flip-flop.
  output: [4]bool,
  /// The noise shift register, and what it last put out.
  lfsr: u16,
  noise_out: bool,
  /// The register the last latch byte chose: channel (bits 2–1) and volume (bit 0).
  latched: u8,
}

pub let new_psg = pure () -> Psg => Psg {
  period: #[0, 0, 0, 0],
  volume: #[15, 15, 15, 15],
  counter: #[0, 0, 0, 0],
  output: #[false, false, false, false],
  lfsr: 0x8000,
  noise_out: false,
  latched: 0,
}

/// A byte written to the PSG: a latch byte (bit 7 set) chooses a register — channel in
/// bits 6–5, volume if bit 4 — and writes its low 4 bits; a data byte writes the latched
/// register's upper bits (a tone period's 9–4) or, for a volume or the noise register, its
/// low 4 bits.
pub let write_psg = (psg: mut Psg, value: u8) -> void => {
  if (value & 0x80) != 0 {
    psg.latched = (value >> 4) & 7
    set_low(psg, value & 0x0F)
    return
  }
  let channel = i64(psg.latched >> 1)
  if (psg.latched & 1) == 0 && channel < 3 {
    psg.period[channel] = (psg.period[channel] & 0x00F) | ((u16(value) & 0x3F) << 4)
  } else {
    set_low(psg, value & 0x0F)
  }
}

/// The latched register's low 4 bits.
let set_low = (psg: mut Psg, bits: u8) -> void => {
  let channel = i64(psg.latched >> 1)
  if (psg.latched & 1) != 0 {
    psg.volume[channel] = bits
  } else if channel < 3 {
    psg.period[channel] = (psg.period[channel] & 0x3F0) | u16(bits)
  } else {
    psg.period[3] = u16(bits & 7)
    psg.lfsr = 0x8000
  }
}

/// One tick: every counter counts, the flips fall where they fall, and the noise register
/// steps on its channel's rising edge.
pub let tick_psg = (psg: mut Psg) -> void => {
  for channel in 0..<4 {
    if psg.counter[channel] != 0 { psg.counter[channel] -= 1 }
    if psg.counter[channel] == 0 {
      psg.counter[channel] = reload(psg, channel)
      psg.output[channel] = !psg.output[channel]
      if channel == 3 && psg.output[3] { step_noise(psg) }
    }
  }
}

/// A channel's period: a tone's own; the noise channel's 16, 32 or 64 ticks by its
/// control's low bits, or tone 3's when they are both set.
let reload = pure (psg: ref Psg, channel: i64) -> u16 => {
  if channel < 3 { return psg.period[channel] }
  match psg.period[3] & 3 {
    0 => 0x10,
    1 => 0x20,
    2 => 0x40,
    _ => psg.period[2],
  }
}

/// The noise register's step: bit 0 out, rotated right, and for white noise (control bit
/// 2) bit 15 XORed with the bit that was 3.
let step_noise = (psg: mut Psg) -> void => {
  psg.noise_out = (psg.lfsr & 1) != 0
  let white = (psg.period[3] & 4) != 0
  let tap = ((psg.lfsr >> 3) & 1) != 0
  psg.lfsr = (psg.lfsr >> 1) | ((psg.lfsr & 1) << 15)
  if white && tap { psg.lfsr = psg.lfsr ~ 0x8000 }
}

/// Channel `channel`'s output now: its attenuation's level while its wave (or the noise)
/// is high, else 0.
pub let channel_level = pure (psg: ref Psg, channel: i64) -> i64 => {
  let high = if channel < 3 { psg.output[channel] } else { psg.noise_out }
  if high { level(psg.volume[channel]) } else { 0 }
}

/// An attenuation's amplitude, out of 32767: 2 dB a step, 15 silent (SMS Power's table,
/// from the chip's measured output).
pub let level = pure (attenuation: u8) -> i64 => LEVELS[i64(attenuation & 15)]

const LEVELS: [16]i64 = #[
  32767, 26028, 20675, 16422, 13045, 10362, 8231, 6568,
  5193, 4125, 3277, 2603, 2067, 1642, 1304, 0,
]
