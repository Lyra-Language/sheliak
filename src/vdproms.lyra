// vdproms — writes the VDP test ROMs that tests/vdp.sh runs on BlastEm and on Sheliak.
//
//   build/vdproms OUT_DIR
//
// Each ROM is a Genesis cartridge that programs the VDP through its ports in straight-line
// code and then parks in a `bra.s *`; beside each `NAME.bin` goes `NAME.park`, that loop's
// address in hex, which is where both emulators stop and dump the VDP. The code is encoded
// here by hand — a handful of 68000 instructions, each named for what it encodes — so the
// harness needs no assembler.

import std.io.{ write_bytes, write_file, create_dir_all }

const CODE: u32 = 0x200
const ERROR_LOOP: u32 = 0x1FC
const ROM_SIZE: i64 = 0x30000
/// Where the 68000 → VDP DMA source tables sit in ROM.
const TABLE: u32 = 0x1000
/// A table straddling the 128 KB boundary a DMA source cannot cross.
const BOUNDARY_TABLE: u32 = 0x1FFF0

const VDP_DATA: u32 = 0xC00000
const VDP_CONTROL: u32 = 0xC00004
const VDP_HV: u32 = 0xC00008
const RAM: u32 = 0xFF0000

let main = () -> u8 => {
  let args = program_args()
  if args.len() < 2 {
    println("usage: vdproms OUT_DIR")
    return 2
  }
  let out = args[1]
  if !create_dir_all(out) {
    println("vdproms: cannot create ${out}")
    return 1
  }
  for name in TESTS {
    var a = Asm { code: [], blobs: [], vectors: [] }
    tmss(a)
    // Every register set first, as a game's start-up does, so what the VDP holds at power-on
    // — which differs between emulators, and is not well documented for the hardware — plays
    // no part. Mode 5 (register 1 bit 2) throughout.
    if name != "registers" {
      for r in 0..<24 { a.reg(r, if r == 1 { 0x04 } else { 0 }) }
    }
    body(name, a)
    let park = CODE + u32(a.code.len())
    a.w(0x60FE)
    let slack = hslack(name)
    if !write_bytes(
      "${out}/${name}.bin",
      rom(a)
    ) || !write_file("${out}/${name}.park", park.to_hex()) ||
      (slack >= 0 && !write_file("${out}/${name}.hslack", "${slack}")) {
      println("vdproms: cannot write ${name}")
      return 1
    }
  }
  println("vdproms: ${TESTS.len()} ROMs in ${out}")
  0
}

const TESTS: []string = [
  "registers",
  "register_bits",
  "vram_words",
  "cram_vsram",
  "commands",
  "byte_ports",
  "reads",
  "fill",
  "copy",
  "dma_68k",
  "dma_disabled",
  "draw_planes",
  "draw_line_scroll",
  "draw_cell_scroll",
  "draw_window_left",
  "draw_window_down",
  "draw_sprites",
  "draw_sprite_limits",
  "draw_shadow",
  "draw_shadow_blank",
  "draw_h32",
  "draw_left_blank",
  "draw_wide_plane",
  "vblank_edges",
  "hblank_edges",
  "vint",
  "hint",
  "hv_latch",
  "fifo_active",
  "fifo_blank",
  "dma_vram_active",
  "dma_vram_blank",
  "dma_cram_active",
  "fill_active",
  "copy_active",
  "read_active",
  "mid_cram",
  "mid_vscroll",
  "mid_cram_h32",
  "pads",
  "z80_run",
]

/// The code of the test `name`. (A `match` rather than a table of functions: each takes the
/// encoder by `mut`, which a function value cannot pass.)
let body = (name: string, a: mut Asm) -> void => match name {
  "registers" => registers(a),
  "register_bits" => register_bits(a),
  "vram_words" => vram_words(a),
  "cram_vsram" => cram_vsram(a),
  "commands" => commands(a),
  "byte_ports" => byte_ports(a),
  "reads" => reads(a),
  "fill" => fill(a),
  "copy" => copy(a),
  "dma_68k" => transfers(a),
  "dma_disabled" => dma_disabled(a),
  "draw_planes" => draw_planes(a),
  "draw_line_scroll" => draw_line_scroll(a),
  "draw_cell_scroll" => draw_cell_scroll(a),
  "draw_window_left" => draw_window_left(a),
  "draw_window_down" => draw_window_down(a),
  "draw_sprites" => draw_sprites(a),
  "draw_sprite_limits" => draw_sprite_limits(a),
  "draw_shadow" => draw_shadow(a),
  "draw_shadow_blank" => draw_shadow_blank(a),
  "draw_h32" => draw_h32(a),
  "draw_left_blank" => draw_left_blank(a),
  "draw_wide_plane" => draw_wide_plane(a),
  "vblank_edges" => vblank_edges(a),
  "hblank_edges" => hblank_edges(a),
  "vint" => vint(a),
  "hint" => hint(a),
  "hv_latch" => hv_latch(a),
  "fifo_active" => fifo_active(a),
  "fifo_blank" => fifo_blank(a),
  "dma_vram_active" => dma_vram_active(a),
  "dma_vram_blank" => dma_vram_blank(a),
  "dma_cram_active" => dma_cram_active(a),
  "fill_active" => fill_active(a),
  "copy_active" => copy_active(a),
  "read_active" => read_active(a),
  "mid_cram" => mid_cram(a),
  "mid_vscroll" => mid_vscroll(a),
  "mid_cram_h32" => mid_cram_h32(a),
  "pads" => pads(a),
  _ => z80_run(a),
}

/// The H slack each timing test is compared with, in slots (tests/vdp.sh reads it from the
/// ROM's `.hslack`); none for the rest, whose RAM must match exactly.
///
/// - **8 for an H read as a handler starts.** Sheliak's 68000 takes Motorola's 44 cycles to
///   enter an interrupt (Yacht's sequence), BlastEm's about 10 fewer, and BlastEm's STOP
///   looks for the interrupt every 4 cycles: about 5 slots, one way.
/// - **16 for an edge a loop polls for** — a loop of 16 slots, which sees the edge anywhere
///   in one of them.
let hslack = pure (name: string) -> i64 => match name {
  "vint" | "hint" | "fifo_active" | "fifo_blank" | "dma_vram_active" | "dma_vram_blank" |
    "dma_cram_active" | "read_active" => 8,
  "vblank_edges" | "hblank_edges" | "hv_latch" | "fill_active" | "copy_active" => 16,
  _ => -1,
}

// ── The tests ────────────────────────────────────────────────────────────────

/// Every register written — mode 5 kept (register 1 bit 2), the rest arbitrary — and the
/// nonexistent 24–31 written too, which must change nothing.
let registers = (a: mut Asm) -> void => {
  for r in 0..<32 {
    let value = if r == 1 { 0x54 } else { (r * 37 + 11) & 0xFF }
    a.reg(r, value)
  }
}

/// Every register written with every bit set, to see which bits each one keeps.
let register_bits = (a: mut Asm) -> void => {
  for r in 0..<24 { a.reg(r, 0xFF) }
}

/// VRAM word writes: consecutive, at an odd address (bytes swapped), with increments of
/// 1, 2 and 0x80, and wrapping past FFFF.
let vram_words = (a: mut Asm) -> void => {
  a.reg(1, 0x04)
  a.reg(15, 2)
  a.command(0x1, 0x0000)
  for i in 0..<8 { a.data(u16(0x1100 + i * 0x0101)) }
  a.command(0x1, 0x8001)
  a.data(0xABCD)
  a.data(0x1234)
  a.reg(15, 1)
  a.command(0x1, 0x2000)
  for i in 0..<4 { a.data(u16(0xA0A1 + i)) }
  a.reg(15, 0x80)
  a.command(0x1, 0x3000)
  for i in 0..<4 { a.data(u16(0x5000 + i)) }
  a.reg(15, 2)
  a.command(0x1, 0xFFFC)
  for i in 0..<4 { a.data(u16(0xE000 + i)) }
}

/// CRAM past its 64 words (the address wraps into it again), VSRAM past its 40 (ignored).
let cram_vsram = (a: mut Asm) -> void => {
  a.reg(1, 0x04)
  a.reg(15, 2)
  a.command(0x3, 0x0000)
  for i in 0..<66 { a.data(u16(0x0FFF - i * 0x0111)) }
  a.command(0x5, 0x0000)
  for i in 0..<42 { a.data(u16(0x0100 + i * 0x0031)) }
}

/// Half a command: after a full VRAM write at C000, a first half alone moves only address
/// bits 13–0. A register-shaped word while a command is pending is its second half. A
/// register write sets code bits 1–0 to `10`, so a data write after it stores nothing.
let commands = (a: mut Asm) -> void => {
  a.reg(1, 0x04)
  a.reg(15, 2)
  a.command(0x1, 0xC000)
  a.data(0x1111)
  a.control(0x4100)
  a.data(0x2222)
  a.control(0x4200)
  a.control(0x8F04)
  a.data(0x3333)
  a.data(0x4444)
  a.reg(15, 2)
  a.data(0x5555)
}

/// Byte writes to the ports: the byte in both halves of a word.
let byte_ports = (a: mut Asm) -> void => {
  a.reg(1, 0x04)
  a.control_byte(0x87)
  a.reg(15, 2)
  a.command(0x1, 0x0400)
  a.data_byte(0x5A)
  a.data_byte(0xC3)
  a.command(0x3, 0x0010)
  a.data_byte(0x0E)
}

/// Reads back from each memory into work RAM: VRAM (even and odd address), CRAM, VSRAM
/// (inside and past its 40 words), and a read after a write command (nothing).
let reads = (a: mut Asm) -> void => {
  a.reg(1, 0x04)
  a.reg(15, 2)
  a.command(0x1, 0x0800)
  for i in 0..<4 { a.data(u16(0x1234 + i * 0x1111)) }
  a.command(0x3, 0x0020)
  for i in 0..<2 { a.data(u16(0x0ACE - i * 0x0202)) }
  a.command(0x5, 0x0040)
  for i in 0..<4 { a.data(u16(0x03FF - i * 0x0101)) }
  var slot = 0
  a.command(0x0, 0x0800)
  for _ in 0..<3 {
    a.read_to(RAM + u32(slot))
    slot += 2
  }
  a.command(0x0, 0x0803)
  a.read_to(RAM + u32(slot))
  slot += 2
  a.command(0x8, 0x0020)
  for _ in 0..<2 {
    a.read_to(RAM + u32(slot))
    slot += 2
  }
  a.command(0x4, 0x0040)
  for _ in 0..<2 {
    a.read_to(RAM + u32(slot))
    slot += 2
  }
  a.command(0x4, 0x004E)
  for _ in 0..<2 {
    a.read_to(RAM + u32(slot))
    slot += 2
  }
  a.command(0x1, 0x0800)
  a.read_to(RAM + u32(slot))
}

/// VRAM fills: increment 1 from an even address, increment 2 from an odd one.
let fill = (a: mut Asm) -> void => {
  a.reg(1, 0x14)
  a.reg(15, 1)
  a.dma_length(0x20)
  a.reg(23, 0x80)
  a.command(0x21, 0x0100)
  a.data(0xABCD)
  a.wait_dma()
  a.reg(15, 2)
  a.dma_length(0x10)
  a.reg(23, 0x80)
  a.command(0x21, 0x0201)
  a.data(0x5678)
  a.wait_dma()
}

/// VRAM copy: 0x30 bytes from 0x0400 to 0x0600, increment 1, then to 0x0701, increment 2.
let copy = (a: mut Asm) -> void => {
  a.reg(1, 0x14)
  a.reg(15, 2)
  a.command(0x1, 0x0400)
  for i in 0..<0x18 { a.data(u16(0x0102 + i * 0x0202)) }
  a.reg(15, 1)
  a.dma_length(0x30)
  a.dma_source_bytes(0x0400)
  a.reg(23, 0xC0)
  a.command(0x30, 0x0600)
  a.wait_dma()
  a.reg(15, 2)
  a.dma_length(0x10)
  a.dma_source_bytes(0x0404)
  a.reg(23, 0xC0)
  a.command(0x30, 0x0701)
  a.wait_dma()
}

/// 68000 → VDP transfers from the ROM table: to VRAM (even, then odd address), CRAM and
/// VSRAM; one whose source crosses the 128 KB boundary; and one from work RAM.
let transfers = (a: mut Asm) -> void => {
  a.reg(1, 0x14)
  a.reg(15, 2)
  a.dma_68k(TABLE, 0x10, 0x1, 0x1000)
  a.dma_68k(TABLE, 0x08, 0x1, 0x1101)
  a.dma_68k(TABLE, 0x20, 0x3, 0x0000)
  a.dma_68k(TABLE, 0x14, 0x5, 0x0000)
  a.dma_68k(BOUNDARY_TABLE, 0x10, 0x1, 0x2000)
  for i in 0..<8 { a.move_w_imm_abs(u16(0xBEE0 + i), RAM + 0x1000 + u32(2 * i)) }
  a.dma_68k(RAM + 0x1000, 0x08, 0x1, 0x3000)
}

/// A DMA command with register 1's DMA enable clear: an ordinary write command.
let dma_disabled = (a: mut Asm) -> void => {
  a.reg(1, 0x04)
  a.reg(15, 2)
  a.dma_length(0x10)
  a.reg(23, 0x80)
  a.command(0x21, 0x0500)
  a.data(0x9876)
  a.data(0x5432)
}

// ── Timing ───────────────────────────────────────────────────────────────────
//
// What the beam does, seen as a program sees it: the HV counter read at an edge of the
// blanking flags, in an interrupt handler, under the latch. Each HV read is split in two, as
// tests/vdp.sh compares them: the V counter into work RAM from FF0010 on, which must match
// exactly, and the H counter from FF0080 on, which must match within the slack the ROM's
// `.hslack` file gives ([hslack]) — the two emulators' 68000s need not take an interrupt,
// or a refresh, at the same cycle. All in 40-cell mode, which the comparison of H assumes.
//
// **Measured from an interrupt, not a polling loop**: the 68000 waits in STOP, so it enters
// the handler a fixed time after the VDP raises the interrupt, and what the handler sees is
// the same whatever the beam was doing at power-on (which the emulators need not agree on).
// A loop polling for an edge still sees it only when it next looks, anywhere in its 16
// slots, so an edge polled for has a looser slack than an interrupt's arrival.

/// The V-blank flag's edges, twice each: set as line 224 begins, clear at line 511.
let vblank_edges = (a: mut Asm) -> void => {
  a.timing_setup(0x44)
  a.wait_status(3, true)
  for _ in 0..<2 {
    a.wait_status(3, false)
    a.record_hv()
    a.wait_status(3, true)
    a.record_hv()
  }
}

/// The H-blank flag's edges, measured from four H interrupts (register 10 = 30): the HV
/// counter as the handler starts, as H-blank ends (H 0), and as the next begins (past 178).
let hblank_edges = (a: mut Asm) -> void => {
  let over = a.begin_skip()
  a.vector(28)
  a.record_hv()
  a.wait_status(2, false)
  a.record_hv()
  a.wait_status(2, true)
  a.record_hv()
  a.w(0x4E73)
  a.end_skip(over)
  a.timing_setup(0x44)
  a.reg(10, 30)
  a.reg(0, 0x14)
  a.wait_for_interrupts(RAM + 0x10 + 12)
}

/// Four V interrupts, each recording the HV counter and the status register's low byte
/// (the interrupt raised flag must read clear, acknowledged).
let vint = (a: mut Asm) -> void => {
  let over = a.begin_skip()
  a.vector(30)
  a.record_hv()
  a.record_status()
  a.w(0x4E73)
  a.end_skip(over)
  a.timing_setup(0x64)
  a.wait_for_interrupts(RAM + 0x10 + 8)
}

/// Sixteen H interrupts every 31st line (register 10 = 30).
let hint = (a: mut Asm) -> void => {
  let over = a.begin_skip()
  a.vector(28)
  a.record_hv()
  a.w(0x4E73)
  a.end_skip(over)
  a.timing_setup(0x44)
  a.reg(10, 30)
  a.reg(0, 0x14)
  a.wait_for_interrupts(RAM + 0x10 + 16)
}

/// The HV counter latched (register 0 bit 1) just after V-blank ends, read twice 80 cycles
/// apart: the difference, which must be zero, and the latched value.
///
///     move.w $C00008, d0 ; 20 × nop ; move.w $C00008, d1
///     sub.w  d0, d1      ; move.w d1, (a0)+
let hv_latch = (a: mut Asm) -> void => {
  a.timing_setup(0x44)
  a.sync_to_display()
  a.reg(0, 0x06)
  a.w(0x3039)
  a.l(VDP_HV)
  for _ in 0..<20 { a.w(0x4E71) }
  a.w(0x3239)
  a.l(VDP_HV)
  a.w(0x9240)
  a.w(0x30C1)
  a.split_d0()
}

// ── Access slots ─────────────────────────────────────────────────────────────
//
// How long the VDP holds the 68000, or how long a DMA runs, where the access slots are
// few (the display drawing: 18 a line in 40-cell mode) and where they are many (V-blank).
// Each runs its work once, in a handler — an H interrupt on line 30 for the active display,
// the V interrupt for V-blank — and records the HV counter as it finishes: the lines it
// took must match exactly, H within the slack. The scratch VRAM at B000 is beyond every
// table these ROMs use. A handler sets everything it depends on, the DMA source included:
// draining a pending interrupt may run it once more beforehand (in Sheliak, whose H
// interrupt counter starts at 0), and a second run must end the same.

/// Twelve VRAM words written back to back on an active line: four fill the FIFO, and each
/// after waits for a word's two slots.
let fifo_active = (a: mut Asm) -> void => {
  let over = a.begin_handler(28)
  a.burst(12)
  a.end_handler(over)
  a.run_on_hint()
}

/// The same twelve in V-blank, where nearly every slot is the FIFO's.
let fifo_blank = (a: mut Asm) -> void => {
  let over = a.begin_handler(30)
  a.burst(12)
  a.end_handler(over)
  a.run_on_vint()
}

/// A 68000 → VRAM transfer of 64 words on active lines: a word per two slots.
let dma_vram_active = (a: mut Asm) -> void => {
  let over = a.begin_handler(28)
  a.dma_68k(TABLE, 64, 1, 0xB000)
  a.end_handler(over)
  a.run_on_hint()
}

/// 400 words in V-blank.
let dma_vram_blank = (a: mut Asm) -> void => {
  let over = a.begin_handler(30)
  a.dma_68k(TABLE, 400, 1, 0xB000)
  a.end_handler(over)
  a.run_on_vint()
}

/// A 68000 → CRAM transfer of 64 words on active lines: a word a slot.
let dma_cram_active = (a: mut Asm) -> void => {
  let over = a.begin_handler(28)
  a.dma_68k(TABLE, 64, 3, 0)
  a.end_handler(over)
  a.run_on_hint()
}

/// A 512-byte VRAM fill on active lines, a byte a slot; waited for by polling.
let fill_active = (a: mut Asm) -> void => {
  let over = a.begin_handler(28)
  a.reg(15, 1)
  a.dma_length(512)
  a.dma_source_bytes(0)
  a.reg(23, 0x80)
  a.command(0x21, 0xB000)
  a.data(0x5A00)
  a.wait_dma()
  a.reg(15, 2)
  a.end_handler(over)
  a.run_on_hint()
}

/// A 128-byte VRAM copy on active lines, two slots a byte; waited for by polling.
let copy_active = (a: mut Asm) -> void => {
  let over = a.begin_handler(28)
  a.reg(15, 1)
  a.dma_length(128)
  a.dma_source_bytes(0x0000)
  a.reg(23, 0xC0)
  a.command(0x30, 0xB000)
  a.wait_dma()
  a.reg(15, 2)
  a.end_handler(over)
  a.run_on_hint()
}

/// Six VRAM words read back to back on an active line: each fetched in two slots.
///
///     lea $C00000, a2 ; 6 × move.w (a2), d1
let read_active = (a: mut Asm) -> void => {
  let over = a.begin_handler(28)
  a.command(0x0, 0xB000)
  a.lea(VDP_DATA, 2)
  for _ in 0..<6 { a.w(0x3212) }
  a.end_handler(over)
  a.run_on_hint()
}

// ── Mid-line changes ─────────────────────────────────────────────────────────
//
// A scene changed while a line goes out, every frame, by an H interrupt at line 150 — so
// the frame compared shows it. The changes go through the FIFO, filled first with four
// scratch VRAM words: then each lands in the external slot the VDP gives it, not where the
// 68000 happened to be (which the emulators do not agree on to the pixel), and the frames
// must match pixel for pixel. The 68000 parks with interrupts on.

/// Palette entries 1–6 changed mid-line and put back: vertical edges where each lands,
/// and a CRAM dot at each.
let mid_cram = (a: mut Asm) -> void => {
  let over = a.begin_skip()
  a.vector(28)
  a.burst(4)
  a.command(0x3, 2)
  for i in 1..<7 { a.data(u16(0x0E0E - i * 0x0202)) }
  a.command(0x3, 2)
  for i in 1..<7 { a.data(palette()[i]) }
  a.w(0x4E73)
  a.end_skip(over)
  scene(a, true)
  a.upload(words_to_bytes([5, 0x3F3]), 0x1, HSCROLL_TABLE)
  a.run_every_frame()
}

/// 2-cell vertical scroll: all 40 VSRAM words rewritten mid-line, then put back — each
/// block fetched after its word lands takes the new value.
let mid_vscroll = (a: mut Asm) -> void => {
  let over = a.begin_skip()
  a.vector(28)
  a.burst(4)
  a.command(0x5, 0)
  for c in 0..<40 { a.data(u16(c * 3 + 40)) }
  a.command(0x5, 0)
  for c in 0..<40 { a.data(u16(c)) }
  a.w(0x4E73)
  a.end_skip(over)
  scene(a, true)
  a.reg(11, 0x04)
  a.upload(words_to_bytes([c in 0..<40 | u16(c)]), 0x5, 0)
  a.run_every_frame()
}

/// The background colour changed mid-line in 32-cell mode, and put back.
let mid_cram_h32 = (a: mut Asm) -> void => {
  let over = a.begin_skip()
  a.vector(28)
  a.burst(4)
  a.command(0x3, 0x42)
  for i in 0..<6 { a.data(u16(0x0222 * (i + 1))) }
  a.data(palette()[0x21])
  a.w(0x4E73)
  a.end_skip(over)
  scene(a, false)
  a.run_every_frame()
}

// ── The I/O chip ─────────────────────────────────────────────────────────────

/// Both controller ports read, no button held: with TH driven high and low (control bit 6
/// set), undriven, and with every line driven; the version and control registers too.
///
///     move.b $A1000x, $FF00yy
let pads = (a: mut Asm) -> void => {
  var at = RAM + 0x10
  for port in 0..<2 {
    let data_port = 0xA10003 + u32(port) * 2
    let control_port = 0xA10009 + u32(port) * 2
    for setting in [
      (0x40, 0x40),
      (0x40, 0x00),
      (0x00, 0x00),
      (0x7F, 0x55),
      (0x40, 0xC0)
    ] {
      let (c, d) = setting
      a.move_b_imm_abs(u8(c), control_port)
      a.move_b_imm_abs(u8(d), data_port)
      a.w(0x4E71)
      a.move_b_abs_abs(data_port, at)
      a.move_b_abs_abs(control_port, at + 1)
      at += 2
    }
  }
  a.move_b_abs_abs(0xA10001, at)
}

// ── The Z80 ──────────────────────────────────────────────────────────────────

/// A Z80 program loaded and run, and what it did read back: the byte it read from the
/// cartridge through the bank window, and the V-blank interrupts (IM 1) it counts while
/// halted — zeroed after the first frame, then read after each of four more (the 68000
/// taking the bus for each look). The first frame is not counted: BlastEm schedules the
/// Z80's first interrupt from the VDP's power-on state (mode 4, whose V-blank starts at
/// line 192), so its Z80 gets one more there than the VDP's actual V-blank gives.
///
///     0000  di ; ld sp,2000h ; im 1
///           ld hl,6000h ; ld a,1 ; ld (hl),a ; ld (hl),a ; xor a ; ld b,7
///           loop: ld (hl),a ; djnz loop           — bank 3: bits 1, 1, then seven 0s
///           ld a,(0FFF5h) ; ld (1000h),a          — cartridge 1FFF5: BOUNDARY_TABLE, 02
///           ei ; wait: halt ; jr wait
///     0038  ld hl,1001h ; inc (hl)               — IM 1: count,
///           ld b,20 ; delay: djnz delay ; ei ; ret
///
/// The handler outlasts /INT (~260 T-states against ~171), so each V-blank is counted once:
/// a handler that re-enables interrupts while /INT is still low is taken again, and how
/// often BlastEm cannot say — it ends the pulse only when it next synchronises the Z80.
let z80_run = (a: mut Asm) -> void => {
  let program: []u8 = [
    0xF3, 0x31, 0x00, 0x20, 0xED, 0x56,
    0x21, 0x00, 0x60, 0x3E, 0x01, 0x77, 0x77, 0xAF, 0x06, 0x07, 0x77, 0x10, 0xFD,
    0x3A, 0xF5, 0xFF, 0x32, 0x00, 0x10,
    0xFB, 0x76, 0x18, 0xFD,
  ]
  let handler: []u8 = [0x21, 0x01, 0x10, 0x34, 0x06, 0x14, 0x10, 0xFE, 0xFB, 0xC9]
  // Sega's sequence: ask for the bus and release the reset, wait for the grant, load, then
  // reset the Z80, give the bus back and release the reset, so it starts at 0000.
  a.reg(1, 0x44)
  a.move_w_imm_abs(0x0100, 0xA11100)
  a.move_w_imm_abs(0x0100, 0xA11200)
  a.wait_z80_bus()
  for i, byte in program { a.move_b_imm_abs(byte, 0xA00000 + u32(i)) }
  for i, byte in handler { a.move_b_imm_abs(byte, 0xA00038 + u32(i)) }
  a.move_b_imm_abs(0, 0xA01000)
  a.move_b_imm_abs(0, 0xA01001)
  a.move_w_imm_abs(0x0000, 0xA11200)
  a.move_w_imm_abs(0x0000, 0xA11100)
  a.move_w_imm_abs(0x0100, 0xA11200)
  a.sync_to_display()
  a.take_z80_bus()
  a.move_b_imm_abs(0, 0xA01001)
  a.move_w_imm_abs(0x0000, 0xA11100)
  for k in 0..<4 {
    a.sync_to_display()
    a.take_z80_bus()
    a.move_b_abs_abs(0xA01001, RAM + 0x11 + u32(k))
    a.move_w_imm_abs(0x0000, 0xA11100)
  }
  a.take_z80_bus()
  a.move_b_abs_abs(0xA01000, RAM + 0x10)
}

// ── Scenes ───────────────────────────────────────────────────────────────────
//
// Each draws a still frame: a common layout (below), the data every scene shares uploaded
// by 68000 → VDP DMA as a game would, then what the scene is about. VRAM: patterns at 0000,
// the window's name table at A000, horizontal scroll at B800, sprites at BC00, plane A at
// C000, plane B at E000.

const WINDOW_TABLE: u32 = 0xA000
const HSCROLL_TABLE: u32 = 0xB800
const SPRITE_TABLE: u32 = 0xBC00
const PLANE_A: u32 = 0xC000
const PLANE_B: u32 = 0xE000
/// Patterns 0–63 are the generated ones; 64 and 65 are solid colours 14 and 15, the
/// shadow/highlight operators' pixels.
const PATTERNS: i64 = 64

/// The layout every scene starts from: 40-cell, 64×32 planes, full-screen scroll, no
/// window, display on — and the palette, patterns, both planes, a first sprite that ends
/// the list, and zero scroll.
let scene = (a: mut Asm, wide: bool) -> void => {
  a.reg(0, 0x04)
  a.reg(1, 0x14)
  a.reg(2, i64(PLANE_A >> 10))
  a.reg(3, i64(WINDOW_TABLE >> 10))
  a.reg(4, i64(PLANE_B >> 13))
  a.reg(5, i64(SPRITE_TABLE >> 9))
  a.reg(7, 0x21)
  a.reg(11, 0)
  a.reg(12, if wide { 0x81 } else { 0x00 })
  a.reg(13, i64(HSCROLL_TABLE >> 10))
  a.reg(15, 2)
  a.reg(16, 0x01)
  a.reg(17, 0)
  a.reg(18, 0)
  a.upload(words_to_bytes(palette()), 0x3, 0)
  a.upload(patterns(), 0x1, 0)
  a.upload(name_table(64, 32, 1), 0x1, PLANE_A)
  a.upload(name_table(64, 32, 2), 0x1, PLANE_B)
  a.upload(name_table(64, 32, 3), 0x1, WINDOW_TABLE)
  a.upload(sprite_entry(0, 0, 0, 0, 0, 0), 0x1, SPRITE_TABLE)
  a.upload([0; 8], 0x1, HSCROLL_TABLE)
  a.upload(words_to_bytes([0; 40]), 0x5, 0)
}

/// The display switched on, last, as a game does.
let display_on = (a: mut Asm) -> void => a.reg(1, 0x54)

/// Planes A and B with full-screen scroll in both directions: priorities, flips and
/// transparency mixed across both name tables.
let draw_planes = (a: mut Asm) -> void => {
  scene(a, true)
  a.upload(words_to_bytes([5, 0x3F3]), 0x1, HSCROLL_TABLE)
  a.upload(words_to_bytes([3, 17]), 0x5, 0)
  display_on(a)
}

/// Per-line horizontal scroll and per-column (2-cell) vertical scroll.
let draw_line_scroll = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(11, 0x07)
  a.upload(
    words_to_bytes([y in 0..<224 * 2 | if (y & 1) == 0 { u16((y / 2 * 3) & 0x3FF) } else { u16((1024 - y / 2) & 0x3FF) }]),
    0x1,
    HSCROLL_TABLE
  )
  a.upload(
    words_to_bytes([c in 0..<40 | if (c & 1) == 0 { u16(c / 2 * 5) } else { u16(c / 2 * 7 + 1) }]),
    0x5,
    0
  )
  display_on(a)
}

/// Per-cell-row horizontal scroll: one pair of values per 8 lines, 32 bytes apart.
let draw_cell_scroll = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(11, 0x02)
  var table: []u16 = [0; 224 * 2]
  for row in 0..<28 {
    table[row * 16] = u16(row * 11)
    table[row * 16 + 1] = u16((1024 - row * 6) & 0x3FF)
  }
  a.upload(words_to_bytes(table), 0x1, HSCROLL_TABLE)
  display_on(a)
}

/// The window over the left 12 cells, plane A scrolled beside it (the window is not).
let draw_window_left = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(17, 0x06)
  a.upload(words_to_bytes([21, 0]), 0x1, HSCROLL_TABLE)
  a.upload(words_to_bytes([9, 0]), 0x5, 0)
  display_on(a)
}

/// The window right of cell 12 and below row 20: on rows 20 onward it spans the line.
let draw_window_down = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(17, 0x86)
  a.reg(18, 0x94)
  display_on(a)
}

/// Sixteen sprites, one of each size, in a list whose links skip around: flips, both
/// priorities, overlapping one another, and cut by every edge of the screen.
let draw_sprites = (a: mut Asm) -> void => {
  scene(a, true)
  var table: []u8 = [0; 16 * 8]
  let order = [0, 5, 2, 9, 12, 1, 7, 15, 3, 10, 6, 13, 4, 8, 11, 14]
  for i, s in order {
    let next = if i + 1 < order.len() { order[i + 1] } else { 0 }
    let x = 40 + s * 19 - (if s == 3 { 70 } else { 0 }) + (if s == 14 { 150 } else { 0 })
    let y = 16 + s * 11 - (if s == 7 { 90 } else { 0 }) + (if s == 15 { 50 } else { 0 })
    let attributes = ((s & 1) << 15) | ((s & 3) << 13) | ((s & 4) << 10) | ((s & 8) << 8) | ((s * 5) % 48)
    for j,
    b in sprite_entry(x, y, s & 3, s >> 2, next, attributes) { table[s * 8 + j] = b }
  }
  a.upload(table, 0x1, SPRITE_TABLE)
  display_on(a)
}

/// Sprite limits on one band of lines: 24 sprites across it (the 21st and later are not
/// drawn), a band where their width passes 320 pixels, and a sprite at x = 0 masking the
/// ones after it.
let draw_sprite_limits = (a: mut Asm) -> void => {
  scene(a, true)
  var table: []u8 = []
  for i in 0..<24 {
    table = [...table, ...sprite_entry(8 + i * 13, 40, 0, 1, i + 1, 10 + i)]
  }
  for i in 0..<12 {
    table = [...table, ...sprite_entry(i * 30, 100, 3, 0, 25 + i, 20 + i)]
  }
  table = [...table, ...sprite_entry(-128, 160, 1, 0, 37, 30)]
  table = [...table, ...sprite_entry(60, 158, 2, 1, 38, 31)]
  table = [...table, ...sprite_entry(70, 170, 2, 1, 0, 32)]
  a.upload(table, 0x1, SPRITE_TABLE)
  display_on(a)
}

/// Shadow/highlight: planes of mixed priority, and sprites of palette 3's operator colours
/// (14 highlights, 15 shadows) over them, beside ordinary sprites of both priorities.
let draw_shadow = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(12, 0x89)
  var table: []u8 = []
  table = [...table, ...sprite_entry(20, 30, 3, 3, 1, 0x6000 | PATTERNS)]
  table = [...table, ...sprite_entry(100, 60, 3, 3, 2, 0x6000 | (PATTERNS + 1))]
  table = [...table, ...sprite_entry(180, 90, 3, 3, 3, 0x8000 | 0x2000 | 12)]
  table = [...table, ...sprite_entry(230, 120, 3, 3, 4, 0x4000 | 17)]
  table = [...table, ...sprite_entry(140, 140, 3, 3, 0, 0xE000 | PATTERNS)]
  a.upload(table, 0x1, SPRITE_TABLE)
  display_on(a)
}

/// Shadow/highlight with the leftmost 8 pixels blanked, which this mode shows as the backdrop
/// shadowed. Each plane's first two cell columns are the same, because BlastEm draws pixels
/// 8–15 of that first 16-pixel column from the planes' pixels 0–7 in this mode alone (its
/// shadow/highlight path does not step the plane offsets past the blanked pixels, where its
/// normal path does). That looks like BlastEm's, not the hardware's; Sheliak does not copy
/// it, and this scene leaves it unexercised rather than let either side's guess stand.
let draw_shadow_blank = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(0, 0x24)
  a.reg(12, 0x89)
  a.upload(first_columns_alike(name_table(64, 32, 1), 64), 0x1, PLANE_A)
  a.upload(first_columns_alike(name_table(64, 32, 2), 64), 0x1, PLANE_B)
  display_on(a)
}

/// A name table with each row's second entry made a copy of its first.
let first_columns_alike = pure (table: []u8, columns: i64) -> []u8 => {
  var out = table
  for r in 0..<(table.len() / (columns * 2)) {
    let at = r * columns * 2
    out[at + 2] = table[at]
    out[at + 3] = table[at + 1]
  }
  out
}

/// 32-cell mode: 256 pixels wide, a 32×32 plane, the window over the left 4 cells.
let draw_h32 = (a: mut Asm) -> void => {
  scene(a, false)
  a.reg(16, 0x00)
  a.reg(17, 0x02)
  a.upload(name_table(32, 32, 4), 0x1, PLANE_B)
  a.upload(sprite_entry(200, 50, 2, 2, 0, 25), 0x1, SPRITE_TABLE)
  display_on(a)
}

/// Register 0 bit 5: the leftmost 8 pixels show the background colour.
let draw_left_blank = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(0, 0x24)
  a.upload(words_to_bytes([3, 0]), 0x1, HSCROLL_TABLE)
  display_on(a)
}

/// A 128×32 plane, scrolled far enough to wrap.
let draw_wide_plane = (a: mut Asm) -> void => {
  scene(a, true)
  a.reg(16, 0x03)
  a.upload(name_table(128, 32, 5), 0x1, PLANE_A)
  a.upload(name_table(128, 32, 6), 0x1, PLANE_B)
  a.upload(words_to_bytes([700, 300]), 0x1, HSCROLL_TABLE)
  display_on(a)
}

// ── Scene data ───────────────────────────────────────────────────────────────

/// 64 colours, every one different: red from bits 0–2 of the index, green from 3–5, blue
/// from a mix of both, so neighbouring indices differ in two components.
let palette = pure () -> []u16 =>
  [i in 0..<64 | u16((((i * 5 + 3) & 7) << 9) | (((i >> 3) & 7) << 5) | ((i & 7) << 1))]

/// The patterns: 64 generated ones, asymmetric in both directions (so a flip shows) and
/// with transparent pixels scattered through them, then two solid ones of colours 14, 15.
let patterns = pure () -> []u8 => {
  var bytes: []u8 = []
  for t in 0..<PATTERNS {
    for y in 0..<8 {
      for pair in 0..<4 {
        let left = pattern_pixel(t, pair * 2, y)
        let right = pattern_pixel(t, pair * 2 + 1, y)
        bytes.push(u8((left << 4) | right))
      }
    }
  }
  for solid in [0xEE, 0xFF] {
    for _ in 0..<32 { bytes.push(u8(solid)) }
  }
  bytes
}

let pattern_pixel = pure (t: i64, x: i64, y: i64) -> i64 =>
  (t * 7 + x * 3 + y * 5 + x * y) & 15

/// A name table `columns` × `rows`, entries varied by `seed`: pattern, palette, both flips
/// and priority all changing across it.
let name_table = pure (columns: i64, rows: i64, seed: i64) -> []u8 => {
  var words: []u16 = []
  for r in 0..<rows {
    for c in 0..<columns {
      let pattern = (c * 3 + r * 5 + seed * 7) % PATTERNS
      let pal = ((c + r + seed) >> 1) & 3
      let hflip = if (c + seed) % 3 == 0 { 0x0800 } else { 0 }
      let vflip = if (r + seed) % 4 == 0 { 0x1000 } else { 0 }
      let high = if (c * r + seed) % 5 == 0 { 0x8000 } else { 0 }
      words.push(u16(high | vflip | hflip | (pal << 13) | pattern))
    }
  }
  words_to_bytes(words)
}

/// An 8-byte sprite entry: screen position (x, y), size in cells less one (w, h), the link,
/// and the attribute word (priority, palette, flips, first pattern).
let sprite_entry = pure (
  x: i64,
  y: i64,
  w: i64,
  h: i64,
  link: i64,
  attributes: i64
) -> []u8 => words_to_bytes([
  u16((y + 128) & 0x3FF),
  u16((w << 10) | (h << 8) | link),
  u16(attributes),
  u16((x + 128) & 0x1FF),
])

let words_to_bytes = pure (words: []u16) -> []u8 => {
  var bytes: []u8 = []
  for w in words {
    bytes.push(u8(w >> 8))
    bytes.push(u8(w & 0xFF))
  }
  bytes
}

// ── A cartridge ──────────────────────────────────────────────────────────────

/// The ROM image: vectors, header, the code at CODE, the DMA tables, zero padding.
let rom = (a: Asm) -> []u8 => {
  var image: []u8 = [0; ROM_SIZE]
  put_long(image, 0, 0x00FFFE00)
  put_long(image, 4, CODE)
  for v in 2..<64 { put_long(image, v * 4, ERROR_LOOP) }
  for v in a.vectors { put_long(image, v.number * 4, v.address) }
  let header = "SEGA MEGA DRIVE "
  for i, c in header { image[0x100 + i] = u8(i64(c)) }
  put_long(image, 0x1A0, 0)
  put_long(image, 0x1A4, u32(ROM_SIZE - 1))
  put_long(image, 0x1A8, 0xFF0000)
  put_long(image, 0x1AC, 0xFFFFFF)
  for i, c in "JUE" { image[0x1F0 + i] = u8(i64(c)) }
  put_word(image, i64(ERROR_LOOP), 0x60FE)
  for i, b in a.code { image[i64(CODE) + i] = b }
  for i in 0..<0x40 {
    put_word(image, i64(TABLE) + 2 * i, u16(0x0102 + i * 0x0303))
    put_word(image, i64(BOUNDARY_TABLE) + 2 * i, u16(0x7700 + i))
  }
  for i, b in a.blobs { image[i64(DATA) + i] = b }
  image
}

let put_word = (image: mut []u8, at: i64, value: u16) -> void => {
  image[at] = u8(value >> 8)
  image[at + 1] = u8(value & 0xFF)
}

let put_long = (image: mut []u8, at: i64, value: u32) -> void => {
  put_word(image, at, u16(value >> 16))
  put_word(image, at + 2, u16(value & 0xFFFF))
}

/// The TMSS handshake a cartridge makes: if the version register's low nibble is non-zero,
/// write "SEGA" to A14000, or the VDP stays locked.
let tmss = (a: mut Asm) -> void => {
  a.w(0x1039)
  a.l(0xA10001)
  a.w(0x0200)
  a.w(0x000F)
  a.w(0x670A)
  a.move_l_imm_abs(0x53454741, 0xA14000)
}

// ── The encoder ──────────────────────────────────────────────────────────────

struct Asm {
  code: []u8,
  /// Data placed in ROM from DATA on, for DMA to upload.
  blobs: []u8,
  /// Exception vectors pointed into the code, the rest at the error loop.
  vectors: []Vector,
}

struct Vector {
  number: i64,
  address: u32,
}

/// Where scene data goes in ROM: after the tables, before the 128 KB boundary table.
const DATA: u32 = 0x4000

/// Place `bytes` in ROM (word-aligned) and upload them by DMA into the memory `target`
/// names (1 VRAM, 3 CRAM, 5 VSRAM) at `address`, waiting for it to finish.
let upload = (self: mut Asm, bytes: []u8, target: i64, address: u32) -> void => {
  let at = DATA + u32(self.blobs.len())
  for b in bytes { self.blobs.push(b) }
  if (self.blobs.len() & 1) != 0 { self.blobs.push(0) }
  self.dma_68k(at, (bytes.len() + 1) / 2, target, address)
}

let w = (self: mut Asm, word: u16) -> void => {
  self.code.push(u8(word >> 8))
  self.code.push(u8(word & 0xFF))
}

let l = (self: mut Asm, long: u32) -> void => {
  self.w(u16(long >> 16))
  self.w(u16(long & 0xFFFF))
}

/// move.w #imm, (xxx).l
let move_w_imm_abs = (self: mut Asm, imm: u16, addr: u32) -> void => {
  self.w(0x33FC)
  self.w(imm)
  self.l(addr)
}

/// move.l #imm, (xxx).l
let move_l_imm_abs = (self: mut Asm, imm: u32, addr: u32) -> void => {
  self.w(0x23FC)
  self.l(imm)
  self.l(addr)
}

/// move.b #imm, (xxx).l
let move_b_imm_abs = (self: mut Asm, imm: u8, addr: u32) -> void => {
  self.w(0x13FC)
  self.w(u16(imm))
  self.l(addr)
}

/// move.b (xxx).l, (xxx).l
let move_b_abs_abs = (self: mut Asm, from: u32, to: u32) -> void => {
  self.w(0x13F9)
  self.l(from)
  self.l(to)
}

/// move.w (xxx).l, (xxx).l
let move_w_abs_abs = (self: mut Asm, from: u32, to: u32) -> void => {
  self.w(0x33F9)
  self.l(from)
  self.l(to)
}

/// A word to the control port.
let control = (self: mut Asm, word: u16) -> void => self.move_w_imm_abs(word, VDP_CONTROL)

let control_byte = (self: mut Asm, byte: u8) -> void =>
  self.move_b_imm_abs(byte, VDP_CONTROL)

/// A word to the data port.
let data = (self: mut Asm, word: u16) -> void => self.move_w_imm_abs(word, VDP_DATA)

let data_byte = (self: mut Asm, byte: u8) -> void => self.move_b_imm_abs(byte, VDP_DATA)

/// A word from the data port, stored at `to`.
let read_to = (self: mut Asm, to: u32) -> void => self.move_w_abs_abs(VDP_DATA, to)

/// Register `r` set to `value`.
let reg = (self: mut Asm, r: i64, value: i64) -> void =>
  self.control(u16(0x8000 | ((r & 0x1F) << 8) | (value & 0xFF)))

/// The command word for code `cd` (6 bits) and a 16-bit address, as one long write.
let command = (self: mut Asm, cd: i64, address: u32) -> void => {
  let high_half = u32(((cd & 3) << 14) | i64(address & 0x3FFF))
  let low_half = u32(((cd >> 2) << 4) | i64((address >> 14) & 3))
  self.move_l_imm_abs((high_half << 16) | low_half, VDP_CONTROL)
}

/// DMA length, registers 19–20.
let dma_length = (self: mut Asm, length: i64) -> void => {
  self.reg(19, length & 0xFF)
  self.reg(20, (length >> 8) & 0xFF)
}

/// A VRAM copy's source byte address, registers 21–22.
let dma_source_bytes = (self: mut Asm, source: i64) -> void => {
  self.reg(21, source & 0xFF)
  self.reg(22, (source >> 8) & 0xFF)
}

/// A 68000 → VDP transfer of `words` words from `source` into the memory `target` names
/// (1 VRAM, 3 CRAM, 5 VSRAM) at `address`.
let dma_68k = (
  self: mut Asm,
  source: u32,
  words: i64,
  target: i64,
  address: u32
) -> void => {
  self.dma_length(words)
  let s = i64(source >> 1)
  self.reg(21, s & 0xFF)
  self.reg(22, (s >> 8) & 0xFF)
  self.reg(23, (s >> 16) & 0x7F)
  self.command(0x20 | target, address)
  self.wait_dma()
}

/// Wait while the status register says a DMA is running (bit 1), as a program must before
/// touching the VDP again — a fill or copy runs on while the 68000 does:
///
///     loop: move.w $C00004, d0
///           btst   #1, d0
///           bne.s  loop
let wait_dma = (self: mut Asm) -> void => {
  self.w(0x3039)
  self.l(VDP_CONTROL)
  self.w(0x0800)
  self.w(0x0001)
  self.w(0x66F4)
}

// ── Timing code ──

/// The address the next instruction is encoded at.
let here = pure (self: Asm) -> u32 => CODE + u32(self.code.len())

/// Exception vector `number` pointed at the next instruction.
let vector = (self: mut Asm, number: i64) -> void =>
  self.vectors.push(Vector { number: number, address: self.here() })

/// `bra.w` over what follows, to [end_skip]; returns where its displacement goes.
let begin_skip = (self: mut Asm) -> i64 => {
  self.w(0x6000)
  let at = self.code.len()
  self.w(0)
  at
}

/// The branch [begin_skip] made lands here.
let end_skip = (self: mut Asm, at: i64) -> void => {
  let displacement = u16(self.code.len() - at)
  self.code[at] = u8(displacement >> 8)
  self.code[at + 1] = u8(displacement & 0xFF)
}

/// move.w #value, sr
let set_sr = (self: mut Asm, value: u16) -> void => {
  self.w(0x46FC)
  self.w(value)
}

/// lea (xxx).l, An
let lea = (self: mut Asm, address: u32, an: i64) -> void => {
  self.w(u16(0x41F9 | (an << 9)))
  self.l(address)
}

/// 40-cell mode, register 1 as given, a0 at the exact table and a1 at the tolerant one.
let timing_setup = (self: mut Asm, reg1: i64) -> void => {
  self.reg(12, 0x81)
  self.reg(1, reg1)
  self.lea(RAM + 0x10, 0)
  self.lea(RAM + 0x80, 1)
}

/// Wait until status bit `bit` reads `set`:
///
///     loop: move.w $C00004, d0
///           btst   #bit, d0
///           beq.s  loop          (bne.s, to wait for it clear)
let wait_status = (self: mut Asm, bit: u16, set: bool) -> void => {
  self.w(0x3039)
  self.l(VDP_CONTROL)
  self.w(0x0800)
  self.w(bit)
  self.w(if set { 0x67F4 } else { 0x66F4 })
}

/// Through a V-blank to its end: the beam at the top of the frame, whatever it was doing.
let sync_to_display = (self: mut Asm) -> void => {
  self.wait_status(3, true)
  self.wait_status(3, false)
}

/// The HV counter into d0, then [split_d0].
let record_hv = (self: mut Asm) -> void => {
  self.w(0x3039)
  self.l(VDP_HV)
  self.split_d0()
}

/// An HV value in d0 recorded: H to (a1)+, V to (a0)+.
///
///     move.b d0, (a1)+ ; lsr.w #8, d0 ; move.b d0, (a0)+
let split_d0 = (self: mut Asm) -> void => {
  self.w(0x12C0)
  self.w(0xE048)
  self.w(0x10C0)
}

/// The status register's low byte to (a0)+: move.b $C00005, (a0)+
let record_status = (self: mut Asm) -> void => {
  self.w(0x10F9)
  self.l(VDP_CONTROL + 1)
}

/// Through a V-blank, so the H interrupt counter has been reloaded; then whatever is still
/// pending taken and recorded out of the way, past the RAM compared (what was raised before
/// depends on the counter's power-on value, which the emulators need not agree on) — a
/// `nop` unmasked, as BlastEm's 68000 takes an interrupt one instruction later than
/// Sheliak's after the mask is lowered (which is right is not yet settled); then,
/// with a0 and a1 at the tables, wait in STOP until the handlers have moved a0 to `end`, and
/// mask interrupts again.
///
///           move.w #$2000, sr ; nop ; move.w #$2700, sr
///           lea    tables, a0 ; lea tables, a1
///           move.w #$2000, sr
///     loop: stop   #$2000
///           cmpa.l #end, a0 ; bne.s loop
///           move.w #$2700, sr
let wait_for_interrupts = (self: mut Asm, end: u32) -> void => {
  self.lea(RAM + 0x100, 0)
  self.lea(RAM + 0x180, 1)
  self.sync_to_display()
  self.set_sr(0x2000)
  self.w(0x4E71)
  self.set_sr(0x2700)
  self.lea(RAM + 0x10, 0)
  self.lea(RAM + 0x80, 1)
  self.set_sr(0x2000)
  self.w(0x4E72)
  self.w(0x2000)
  self.w(0xB1FC)
  self.l(end)
  self.w(0x66F4)
  self.set_sr(0x2700)
}

/// A handler for exception `vector`, jumped over by the code before it; see [end_handler].
let begin_handler = (self: mut Asm, vector: i64) -> i64 => {
  let over = self.begin_skip()
  self.vector(vector)
  over
}

/// The handler ends by recording the HV counter, and returns.
let end_handler = (self: mut Asm, over: i64) -> void => {
  self.record_hv()
  self.w(0x4E73)
  self.end_skip(over)
}

/// The handler run once, on the H interrupt of line 30: display and DMA on, register 10
/// = 30, the H interrupt enabled.
let run_on_hint = (self: mut Asm) -> void => {
  self.timing_setup(0x54)
  self.reg(10, 30)
  self.reg(0, 0x14)
  self.wait_for_interrupts(RAM + 0x10 + 1)
}

/// The handler run once, on the V interrupt: display, DMA and the V interrupt on.
let run_on_vint = (self: mut Asm) -> void => {
  self.timing_setup(0x74)
  self.wait_for_interrupts(RAM + 0x10 + 1)
}

/// `n` words to VRAM at B000 as fast as the 68000 writes them:
///
///     lea $C00000, a2 ; n × move.w d1, (a2)
let burst = (self: mut Asm, n: i64) -> void => {
  self.command(0x1, 0xB000)
  self.lea(VDP_DATA, 2)
  for _ in 0..<n { self.w(0x3481) }
}

/// The display on, the H interrupt at line 150 of every frame (register 10 = 150), and
/// interrupts unmasked for good.
let run_every_frame = (self: mut Asm) -> void => {
  self.reg(10, 150)
  self.reg(0, 0x14)
  display_on(self)
  self.set_sr(0x2000)
}

/// Ask for the Z80's bus and wait until it is granted.
let take_z80_bus = (self: mut Asm) -> void => {
  self.move_w_imm_abs(0x0100, 0xA11100)
  self.wait_z80_bus()
}

/// Wait for the Z80's bus to be granted: bit 0 of A11100 reads 0.
///
///     loop: btst #0, $A11100 ; bne.s loop
let wait_z80_bus = (self: mut Asm) -> void => {
  self.w(0x0839)
  self.w(0x0000)
  self.l(0xA11100)
  self.w(0x66F6)
}
