module vdp
//! The Genesis video display processor (Yamaha YM7101): its memories, registers and ports,
//! and DMA — the **programming interface**, what the 68000 sees through the control and data
//! ports. What the ports ask for is done in the VDP's **access slots** (`slots.lyra`): a
//! write waits in the FIFO for one, a read is fetched ahead in one, a DMA moves a byte or a
//! word in each. The beam that brings the slots round, and with it the status bits, the HV
//! counter and the interrupts, is `beam.lyra`; drawing a line, `render.lyra`.
//!
//! **Checked against BlastEm** (`tests/vdp.sh`): test ROMs program the VDP, both emulators
//! run them to a parking loop, and the memories, registers, address and code registers are
//! compared byte for byte. Where the classic documentation (Charles MacDonald's genvdp.txt)
//! is silent or wrong, that comparison is the authority.
//!
//! **The address and code registers** are what the ports act through. A control-port word
//! is either a register write (`10rrrrrr dddddddd`) or the first half of a command; the
//! first half sets address bits 13–0 and code bits 1–0, the second (after it, whatever it
//! looks like) address bits 16–14 (its bits 2–0: A16 is the 128 KB-VRAM mode's) and code
//! bits 5–2. The address register is **17 bits**, and an increment carries into bit 16;
//! 64 KB of VRAM sees the low 16. Code bits 3–0 choose the memory and direction of
//! data-port accesses, bit 5 starts a DMA.
//!
//! **What the oracle settled** where genvdp.txt did not: a register write has a first half's
//! effect on the address and code registers (so it leaves CD1–0 at `10`, no memory);
//! register 7 keeps 6 bits and every other all 8; a data-port read with a write code returns
//! the last value read; CRAM and VSRAM reads take their unused bits from the write FIFO's
//! oldest entry; a fill advances the source registers too; a copy reads and writes with
//! address bit 0 flipped; CD5 is cleared when a DMA ends or cannot start. (A copy seemed to
//! end one increment further than its length: that is the read the VDP fetches ahead once
//! the copy leaves a read code behind — `slots.lyra`.)

/// VRAM, CRAM and VSRAM sizes.
pub const VRAM_SIZE: i64 = 65536
pub const CRAM_WORDS: i64 = 64
pub const VSRAM_WORDS: i64 = 40

/// The VDP's state. The memories are dynamic arrays, sized once by [new_vdp].
pub struct Vdp {
  /// 64 KB of video RAM, in address order: a word's high byte at its even address.
  vram: []u8,
  /// 64 colours, `----bbb-ggg-rrr-`.
  cram: []u16,
  /// 40 vertical scroll values.
  vsram: []u16,
  /// Registers 0–23.
  regs: [24]u8,
  /// The address register, 17 bits.
  address: u32,
  /// The code register, 6 bits: CD5 (DMA), CD4 (copy), CD3–CD0 (memory and direction).
  code: u8,
  /// The first half of a command word has been written, and the next control-port word is
  /// its second half.
  pending: bool,
  // The access slots (slots.lyra).
  /// The write FIFO, a ring of four: [fifo_write] is where the next word goes — and, being
  /// the oldest entry, what a CRAM or VSRAM read takes its unused bits from — and
  /// [fifo_read] the next a slot takes, -1 when none waits.
  fifo: [4]FifoEntry,
  fifo_write: i64,
  fifo_read: i64,
  /// A DMA is moving data (CD5 alone says one has been asked for: a fill waits for its value).
  dma_run: bool,
  /// The word a 68000 → VDP transfer takes next, which the bus supplies from [dma_source]
  /// before each slot while it runs (the 68000 is off the bus, so nothing else reads it).
  dma_word: u16,
  /// What a read fetched ahead, or a copy read: the value a data-port read returns.
  prefetch: u16,
  /// [prefetch] holds a fetched word the port has not yet returned (or a copy's byte).
  fetched: bool,
  /// A VRAM read has fetched its word's high byte, and fetches the low one next.
  read_half: bool,
  /// The master clock before which no slot fetches ahead for a read.
  read_latency: i64,
  /// The master clock at which the 68000 may go on after its last port access: past a
  /// wait for FIFO room, for a read, or for a 68000 → VDP transfer (the bus's to apply).
  resume_at: i64,
  // The beam (beam.lyra).
  /// The master clock at which the current slot began.
  clock: i64,
  /// The H counter: the current slot.
  hslot: u16,
  /// The V counter, 9 bits.
  vcounter: u16,
  phase: Phase,
  /// Lines until the H interrupt, counting down.
  hint_counter: u8,
  /// The V and H interrupts have been raised and not yet acknowledged.
  vint_pending: bool,
  /// The master clock the V interrupt was last raised at, which pulls the Z80's /INT low
  /// for a while (the bus's to time).
  z80_int_at: i64,
  hint_pending: bool,
  /// The HV counter as latched by register 0 bit 1.
  hv_latch: u16,
  // The picture (render.lyra).
  /// The vertical scroll latches, planes A and B.
  vscroll_latch: [2]u16,
  /// The line's horizontal scroll, planes A and B, as read in its H-blank.
  line_hscroll: [2]i64,
  /// The line's plane pixels as fetched, 16 a block from the partial block (-1) on.
  strip_a: []Dot,
  strip_b: []Dot,
  /// Which of the line's blocks are the window's, and the window's pixels in them.
  window_blocks: []bool,
  window_dots: []Dot,
  /// The sprites' pixels on the line coming up, and on the row going out.
  sprites_next: []Dot,
  sprites_row: []Dot,
  /// The row going out (-1 while none is), and its width.
  row: i64,
  row_width: i64,
  /// The frame being drawn, row by row, at the width of its last row.
  drawing: []u16,
  drawing_width: i64,
  /// The last frame completed, and how many have been.
  shown: Frame,
  frames: i64,
}

/// A VDP at power-on: memories and registers zero, the FIFO empty, the beam at the top of an
/// active frame.
pub let new_vdp = pure () -> Vdp => Vdp {
  vram: [0; VRAM_SIZE],
  cram: [0; CRAM_WORDS],
  vsram: [0; VSRAM_WORDS],
  regs: #[0; 24],
  address: 0,
  code: 0,
  pending: false,
  fifo: #[empty_entry; 4],
  fifo_write: 0,
  fifo_read: -1,
  dma_run: false,
  dma_word: 0,
  prefetch: 0,
  fetched: false,
  read_half: false,
  read_latency: 0,
  resume_at: 0,
  clock: 0,
  hslot: 0,
  vcounter: 0,
  phase: Active,
  hint_counter: 0,
  vint_pending: false,
  z80_int_at: -1000000,
  hint_pending: false,
  hv_latch: 0,
  vscroll_latch: #[0, 0],
  line_hscroll: #[0, 0],
  strip_a: [clear_dot; 21 * 16],
  strip_b: [clear_dot; 21 * 16],
  window_blocks: [false; 20],
  window_dots: [clear_dot; 320],
  sprites_next: [clear_dot; 320],
  sprites_row: [clear_dot; 320],
  row: -1,
  row_width: 320,
  drawing: [0; MAX_PIXELS],
  drawing_width: 320,
  shown: Frame { width: 320, height: 224, pixels: [0; 320 * 224] },
  frames: 0,
}

// ── The ports ────────────────────────────────────────────────────────────────
//
// Each takes `now`, the master clock of the 68000's access, with the beam already run to
// it, and leaves in [resume_at] the master clock the 68000 may go on from (which the bus
// rounds up to a whole 68000 cycle).

/// A word written to the control port. A byte write is the byte in both halves (the bus's
/// to duplicate). Answers whether a 68000 → VDP transfer has started, which the bus then
/// feeds, the 68000 off the bus, until it ends ([dma_68k_running]).
pub let write_control = (vdp: mut Vdp, value: u16, now: i64) -> bool => {
  vdp.resume_at = now
  if vdp.pending {
    vdp.pending = false
    vdp.address = (vdp.address & 0x3FFF) | (u32(value & 7) << 14)
    vdp.code = (vdp.code & 3) | u8((value >> 2) & 0x3C)
    vdp.fetched = false
    vdp.read_half = false
    if (vdp.code & 1) == 0 { vdp.read_latency = now + 3 * slot_unit(vdp) }
    if (vdp.code & 0x20) != 0 {
      if !dma_enabled(vdp) {
        vdp.code = vdp.code & 0x1F
        return false
      }
      return start_dma(vdp)
    }
    return false
  }
  // The first half, or a register write, which has the first half's effect on the address
  // and code registers too — so a register write leaves CD1–0 at `10`, which is no memory
  // at all, and a data-port write after it goes nowhere.
  vdp.address = (vdp.address & 0x1C000) | u32(value & 0x3FFF)
  vdp.code = (vdp.code & 0x3C) | u8(value >> 14)
  if (value & 0xC000) == 0x8000 {
    let reg = i64((value >> 8) & 0x1F)
    if reg == 0 && (value & 0x02) != 0 && (vdp.regs[0] & 0x02) == 0 { latch_hv(vdp) }
    if reg < 24 { vdp.regs[reg] = u8(value & 0xFF) & REGISTER_BITS[reg] }
    return false
  }
  vdp.pending = true
  false
}

/// The bits each register keeps: all eight, but register 7's top two.
const REGISTER_BITS: [24]u8 = #[
  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x3F, 0xFF, 0xFF, 0xFF, 0xFF,
  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
]

/// A word written to the data port: into the FIFO, for a slot to store in the memory the
/// code register names (nowhere, for a read code), the address advancing by register 15.
/// A full FIFO holds the 68000 until a slot takes a word. Under a fill's command, the word
/// is the fill's value, and the fill starts once it has been stored.
pub let write_data = (vdp: mut Vdp, value: u16, now: i64) -> void => {
  end_command(vdp)
  if (vdp.code & 0x20) != 0 && fill_mode(vdp) { vdp.dma_run = false }
  let waited = fifo_full(vdp)
  while fifo_full(vdp) { step_slot(vdp) }
  let from = if waited { vdp.clock + slot_clocks(vdp) } else { seen_at(vdp, now) }
  enqueue(vdp, from, value)
  advance(vdp)
  vdp.resume_at = if waited { vdp.clock + slot_clocks(vdp) } else { now }
}

/// A word read from the data port: the one a slot fetched ahead, from the memory the code
/// register names — the 68000 held until it has been. Under a write code (or a code naming
/// nothing readable) the port returns its last value again. A read lets the next one be
/// fetched after the read latency: three slots, or two when the 68000 waited for this one
/// and resumes within 2 master clocks of the VDP.
pub let read_data = (vdp: mut Vdp, now: i64) -> u16 => {
  end_command(vdp)
  vdp.resume_at = now
  if (vdp.code & 1) != 0 || !readable(vdp.code) { return vdp.prefetch }
  let waited = !vdp.fetched
  while !vdp.fetched { step_slot(vdp) }
  vdp.fetched = false
  let unit = slot_unit(vdp)
  if waited {
    let vdp_now = vdp.clock + slot_clocks(vdp)
    vdp.resume_at = vdp_now
    let resumes = now + round_up(vdp_now - now, 7)
    vdp.read_latency = vdp_now + (if resumes - vdp_now < 2 { 2 } else { 3 }) * unit
  } else {
    vdp.read_latency = now + 2 * unit
  }
  vdp.prefetch
}

/// The status register, read from the control port; reading it also ends a half-written
/// command. Bits 15–10 are not the VDP's: they are whatever the 68000's bus last carried
/// (`open_bus`, the bus's to know). FIFO empty (9) and full (8); DMA (1) while CD5 is set;
/// the beam's bits ([beam_status]).
pub let read_status = (vdp: mut Vdp, open_bus: u16) -> u16 => {
  vdp.pending = false
  var status = (open_bus & 0xFC00) | beam_status(vdp)
  if vdp.fifo_read < 0 { status = status | 0x0200 }
  if fifo_full(vdp) { status = status | 0x0100 }
  if (vdp.code & 0x20) != 0 { status = status | 0x0002 }
  status
}

/// A data-port access ends a half-written command, and whatever was fetched ahead for the
/// old address is dropped.
let end_command = (vdp: mut Vdp) -> void => {
  if !vdp.pending { return }
  vdp.pending = false
  vdp.fetched = false
  vdp.read_half = false
}

/// Codes a slot fetches ahead for: VRAM (0), VSRAM (4), CRAM (8). (The 8-bit VRAM read, C,
/// is not yet built.)
let readable = pure (code: u8) -> bool => {
  let c = code & 0x0F
  c == 0x0 || c == 0x4 || c == 0x8
}

/// `n` rounded up to a multiple of `m`.
pub let round_up = pure (n: i64, m: i64) -> i64 => ((n + m - 1) / m) * m

// ── DMA ──────────────────────────────────────────────────────────────────────

/// Whether register 1 enables DMA (M1, bit 4). A command with CD5 set does nothing more
/// than an ordinary command while it is clear.
let dma_enabled = pure (vdp: ref Vdp) -> bool => (vdp.regs[1] & 0x10) != 0

/// Register 23's bits 7–6: a VRAM fill (`10`), a VRAM copy (`11`); bit 7 clear is a
/// 68000 → VDP transfer.
let fill_mode = pure (vdp: ref Vdp) -> bool => (vdp.regs[23] & 0xC0) == 0x80
let copy_mode = pure (vdp: ref Vdp) -> bool => (vdp.regs[23] & 0xC0) == 0xC0
let transfer_mode = pure (vdp: ref Vdp) -> bool => (vdp.regs[23] & 0x80) == 0

/// The DMA a command with CD5 starts: a fill waits for the data write that supplies its
/// value; a copy runs from the next slot; a 68000 → VDP transfer takes the bus — three
/// slots on (BlastEm's figure, from logic-analyser captures), it runs, and the bus feeds it
/// ([dma_68k_running]). Answers whether that last has begun.
let start_dma = (vdp: mut Vdp) -> bool => {
  if fill_mode(vdp) { return false }
  if copy_mode(vdp) {
    vdp.dma_run = true
    return false
  }
  for _ in 0..<3 { step_slot(vdp) }
  vdp.dma_run = true
  true
}

/// Whether a 68000 → VDP transfer is running — while it is, the bus sets [dma_word] from
/// [dma_source] and steps the VDP a slot at a time, the 68000 held.
pub let dma_68k_running = pure (vdp: ref Vdp) -> bool => vdp.dma_run && transfer_mode(vdp)

/// The 68000 address the transfer's next word comes from: registers 21–23 hold it in words.
pub let dma_source = pure (vdp: ref Vdp) -> u32 =>
  (u32(vdp.regs[23] & 0x7F) << 17) | (u32(vdp.regs[22]) << 9) | (u32(vdp.regs[21]) << 1)

/// The transfer has ended: the 68000 goes on from the slot after the last one it ran in.
pub let dma_68k_done = (vdp: mut Vdp) -> void => { vdp.resume_at = vdp.clock + slot_clocks(vdp) }

/// A DMA has moved a unit: the source advances by one (within its 128 KB window — registers
/// 21–22 only, for a transfer, whose source counts words), the address by register 15, and
/// the length counts down; at zero the DMA ends, and CD5 and CD4 with it. A length of zero
/// counts 65,536.
let advance_dma = (vdp: mut Vdp) -> void => {
  let next = ((u16(vdp.regs[22]) << 8) | u16(vdp.regs[21])).wrapping_add(1)
  vdp.regs[21] = u8(next & 0xFF)
  vdp.regs[22] = u8(next >> 8)
  advance(vdp)
  let length = ((u16(vdp.regs[20]) << 8) | u16(vdp.regs[19])).wrapping_sub(1)
  vdp.regs[19] = u8(length & 0xFF)
  vdp.regs[20] = u8(length >> 8)
  if length == 0 {
    vdp.dma_run = false
    vdp.code = vdp.code & 0x0F
  }
}

// ── Memory ───────────────────────────────────────────────────────────────────

/// The address register advanced by register 15, the auto-increment, within its 17 bits.
let advance = (vdp: mut Vdp) -> void => {
  vdp.address = (vdp.address + u32(vdp.regs[15])) & 0x1FFFF
}
