module vdp
//! The access slots: where in each line the VDP reaches its memories for the 68000 — the
//! FIFO's writes, the reads it fetches ahead, DMA. The rest of a line's slots fetch what it
//! draws, or refresh the DRAM.
//!
//! **What the oracle settled** (BlastEm, from its hardware tests; `tests/vdp.sh`):
//!
//! - **Which slots**: while the display draws, 18 a line in 40-cell mode — H 2, 10, 18, 34,
//!   42, 50, 66, 74, 82, 98, 106, 114, 130, 138, 146 (every eighth from 2 but 26, 58, 90,
//!   122, 154, which refresh), 161, 162 and 232 — and 16 in 32-cell mode: every eighth from
//!   2 to 114 but 26, 58, 90, 122, then 129, 130, 145 and 243. On the line before the first
//!   (V 511), 165–166 (133–134) too. In V-blank, or with the display off, every slot but the
//!   refresh ones: 26, 59, 90, 122, 154, 250 (19, 51, 83, 115, 243 in 32-cell mode — a guess
//!   of BlastEm's, from the 40-cell ones).
//! - **The FIFO**: four words. A word written waits two slots before a slot may take it;
//!   BlastEm counts them from the VDP's view of the write, which it takes to be a slot behind
//!   the 68000 ([seen_at]). A VRAM word takes **two** slots, a byte each, the low byte
//!   first (its address with bit 0 flipped); CRAM and VSRAM one; a word under a code naming
//!   no memory, two when CD2–1 are clear, else one. A write to a full FIFO holds the 68000.
//! - **Reads are fetched ahead**, once a read code is set and the read latency has passed: a
//!   VRAM word in two slots (a byte each), CRAM and VSRAM in one, the address advancing as
//!   the fetch completes — so a read code set and left advances the address once, unread.
//!   Only a slot the FIFO does not need fetches; only a fetched word is returned.
//! - **A fill** stores its byte (the value's high byte, at the address with bit 0 flipped;
//!   into CRAM or VSRAM, the FIFO's oldest word) in each slot the FIFO leaves free; **a
//!   copy** reads in one such slot and writes in the next. **A 68000 → VDP transfer** puts a
//!   word into the FIFO in every slot there is room — in V-blank, every slot a refresh
//!   neither takes nor has just taken; while drawing, every slot but the refresh ones — so
//!   the FIFO's slots pace it.

/// A word written to the data port (or by a 68000 → VDP transfer) waiting for a slot.
pub struct FifoEntry {
  /// The master clock from which a slot may take it.
  ready: i64,
  address: u32,
  code: u8,
  value: u16,
  /// A slot has taken part of it: a VRAM word's low byte (and [address] has been flipped to
  /// the high one's), or it is a fill's, which is a byte from the start.
  partial: bool,
}

let empty_entry = FifoEntry { ready: 0, address: 0, code: 0, value: 0, partial: false }

/// The slot's length in master clocks for the FIFO's and the reads' latencies (16 or 20,
/// whatever horizontal sync does to the slots themselves).
let slot_unit = pure (vdp: Vdp) -> i64 => if h40(vdp) { 16 } else { 20 }

/// Run the beam on by one slot, and do what that slot does.
pub let step_slot = (vdp: mut Vdp) -> void => {
  vdp.clock += slot_clocks(vdp)
  next_slot(vdp)
}

/// The master clock the VDP counts a 68000 access at `now` from, as BlastEm has it: the
/// first slot boundary no more than a slot (less one clock) before it.
let seen_at = pure (vdp: Vdp, now: i64) -> i64 => {
  let lag: i64 = if h40(vdp) { 15 } else { 19 }
  if vdp.clock >= now - lag { vdp.clock } else { vdp.clock + slot_clocks(vdp) }
}

let fifo_full = pure (vdp: Vdp) -> bool => vdp.fifo_write == vdp.fifo_read

/// A word into the FIFO, a slot free to take it two slots after `from`.
let enqueue = (vdp: mut Vdp, from: i64, value: u16) -> void => {
  vdp.fifo[vdp.fifo_write] = FifoEntry {
    ready: from + 2 * slot_unit(vdp),
    address: vdp.address,
    code: vdp.code,
    value: value,
    partial: false,
  }
  if vdp.fifo_read < 0 { vdp.fifo_read = vdp.fifo_write }
  vdp.fifo_write = (vdp.fifo_write + 1) & 3
}

// ── A slot ───────────────────────────────────────────────────────────────────

/// What the slot the beam has just reached does for the 68000 (called by [next_slot]).
let access_slot = (vdp: mut Vdp) -> void => {
  let s = vdp.hslot
  let wide = h40(vdp)
  if vdp.phase != Blank && (vdp.regs[1] & 0x40) != 0 {
    if external_while_drawing(s, wide, vdp.phase == Preparing) { external_slot(vdp) }
    if vdp.dma_run && !refresh_while_drawing(s, wide) { transfer_slot(vdp) }
    return
  }
  if refresh_in_blank(s, wide) { return }
  external_slot(vdp)
  if vdp.dma_run && !refresh_in_blank((s + 255) & 0xFF, wide) { transfer_slot(vdp) }
}

let external_while_drawing = pure (s: u16, wide: bool, preparing: bool) -> bool => {
  if wide {
    if s < 160 { return (s & 7) == 2 && !refresh_while_drawing(s, wide) }
    return s == 161 || s == 162 || s == 232 || (preparing && (s == 165 || s == 166))
  }
  if s < 128 { return (s & 7) == 2 && !refresh_while_drawing(s, wide) }
  s == 129 || s == 130 || s == 145 || s == 243 || (preparing && (s == 133 || s == 134))
}

let refresh_while_drawing = pure (s: u16, wide: bool) -> bool =>
  s == 26 || s == 58 || s == 90 || s == 122 || (wide && s == 154)

let refresh_in_blank = pure (s: u16, wide: bool) -> bool => {
  if wide { return s == 26 || s == 59 || s == 90 || s == 122 || s == 154 || s == 250 }
  s == 19 || s == 51 || s == 83 || s == 115 || s == 243
}

/// An external slot: a fill's next byte queued if the FIFO is empty; then the FIFO's oldest
/// word, if it has waited long enough; else a copy's next read or write; else a read
/// fetched ahead.
let external_slot = (vdp: mut Vdp) -> void => {
  if vdp.dma_run && fill_mode(vdp) && vdp.fifo_read < 0 {
    // The fill's value is the FIFO's last word, queued again as a byte at the address.
    vdp.fifo_read = (vdp.fifo_write + 3) & 3
    vdp.fifo[vdp.fifo_read].ready = vdp.clock
    vdp.fifo[vdp.fifo_read].address = vdp.address
    vdp.fifo[vdp.fifo_read].partial = true
    advance_dma(vdp)
  }
  if vdp.fifo_read >= 0 && vdp.fifo[vdp.fifo_read].ready <= vdp.clock {
    write_slot(vdp)
  } else if vdp.dma_run && copy_mode(vdp) {
    copy_slot(vdp)
  } else if (vdp.code & 1) == 0 && !vdp.fetched && !vdp.pending && vdp.read_latency <= vdp.clock {
    read_slot(vdp)
  }
}

/// The FIFO's oldest word stored — or, for a VRAM word, its first byte.
let write_slot = (vdp: mut Vdp) -> void => {
  let at = vdp.fifo_read
  let entry = vdp.fifo[at]
  match entry.code & 0x0F {
    0x1 => {
      let target = i64((entry.address ~ 1) & 0xFFFF)
      if !entry.partial {
        vdp.vram[target] = u8(entry.value & 0xFF)
        vdp.fifo[at].address = entry.address ~ 1
        vdp.fifo[at].partial = true
        return
      }
      vdp.vram[target] = u8(entry.value >> 8)
    },
    0x3 => {
      let word = if entry.partial { vdp.fifo[vdp.fifo_write].value } else { entry.value }
      vdp.cram[i64((entry.address >> 1) & 0x3F)] = word & 0x0EEE
      cram_dot(vdp, word)
    },
    0x5 => {
      let cell = i64((entry.address >> 1) & 0x3F)
      let word = if entry.partial { vdp.fifo[vdp.fifo_write].value } else { entry.value }
      if cell < VSRAM_WORDS { vdp.vsram[cell] = word & 0x07FF }
    },
    _ => {
      if (vdp.code & 6) == 0 && !entry.partial {
        vdp.fifo[at].partial = true
        return
      }
    },
  }
  vdp.fifo_read = (at + 1) & 3
  if vdp.fifo_read == vdp.fifo_write {
    vdp.fifo_read = -1
    // The FIFO drained under a fill's command: the fill runs (again, after its value).
    if (vdp.code & 0x20) != 0 && fill_mode(vdp) { vdp.dma_run = true }
  }
}

/// A copy's slot: the source byte read (registers 21–22, a byte address, bit 0 flipped), or
/// written to the address (bit 0 flipped) and the DMA advanced.
let copy_slot = (vdp: mut Vdp) -> void => {
  if vdp.fetched {
    vdp.vram[i64((vdp.address ~ 1) & 0xFFFF)] = u8(vdp.prefetch & 0xFF)
    advance_dma(vdp)
    vdp.fetched = false
    return
  }
  let source = (u16(vdp.regs[22]) << 8) | u16(vdp.regs[21])
  vdp.prefetch = u16(vdp.vram[i64(source ~ 1)])
  vdp.fetched = true
}

/// A read fetched ahead, from the memory the code register names; the address advances as
/// the word completes. A CRAM or VSRAM word's unused bits are the FIFO's oldest word's; a
/// VSRAM address past its 40 words reads word 0.
let read_slot = (vdp: mut Vdp) -> void => {
  let oldest = vdp.fifo[vdp.fifo_write].value
  match vdp.code & 0x0F {
    0x0 => {
      if !vdp.read_half {
        vdp.prefetch = u16(vdp.vram[i64(vdp.address & 0xFFFE)]) << 8
        vdp.read_half = true
        return
      }
      vdp.prefetch = vdp.prefetch | u16(vdp.vram[i64((vdp.address & 0xFFFE) | 1)])
      vdp.read_half = false
    },
    0x4 => {
      let cell = i64((vdp.address >> 1) & 0x3F)
      let word = if cell < VSRAM_WORDS { vdp.vsram[cell] } else { vdp.vsram[0] }
      vdp.prefetch = (word & 0x07FF) | (oldest & 0xF800)
    },
    0x8 => {
      vdp.prefetch = (vdp.cram[i64((vdp.address >> 1) & 0x3F)] & 0x0EEE) | (oldest & 0xF111)
    },
    _ => return,
  }
  vdp.fetched = true
  advance(vdp)
}

/// A 68000 → VDP transfer's slot: the word the bus supplied into the FIFO, if it has room.
let transfer_slot = (vdp: mut Vdp) -> void => {
  if !transfer_mode(vdp) || fifo_full(vdp) { return }
  enqueue(vdp, vdp.clock, vdp.dma_word)
  advance_dma(vdp)
}
