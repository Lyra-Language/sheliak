module vdp
//! Mode 5 rendering: a frame drawn line by line from the VDP's state — planes A and B,
//! the window, sprites, priority, shadow/highlight, the background colour.
//!
//! **What comes out is the VDP's output, not RGB**: per pixel, the colour's CRAM word
//! (`----bbb-ggg-rrr-`) and its intensity — normal, shadow or highlight, bits 13–12 — which
//! is what a rendering bug changes. Turning that into light is the display's business (the
//! DAC's 15 levels), and the harness does it only to compare with BlastEm's screenshots.
//!
//! **Drawn as the beam goes** (`beam.lyra` calls [render_slot] at every slot), each thing
//! read when the VDP reads it — BlastEm's schedule, 40-cell (32-cell) mode, for line L:
//!
//! - the sprites on it, as the line before ends (H 163; 131);
//! - its horizontal scroll, early in its H-blank (H 244);
//! - the planes in 16-pixel blocks, each with the vertical scroll it latches then: the
//!   partial block at the left at H 249 (plane A) and 253 (B), block k at H 1 + 8k (A)
//!   and 5 + 8k (B);
//! - its pixels, two a slot, from H 6 (13 pixels of border first, so pixel x goes out at
//!   H 6 + (x + 13) / 2, the last few after the V counter has moved on): **the layers
//!   composed and the colour looked up in CRAM as each pixel goes out**.
//!
//! So a change made mid-line shows from where the VDP next reads what it changed: a colour
//! from the next pixel out, a vertical scroll (2-cell mode) from the next block fetched, a
//! horizontal scroll or a sprite from the next line. **A CRAM write shows as a dot** of the
//! colour written, at the pixel going out as its slot takes it (the hardware's "CRAM dot").
//! The vertical scroll latches once a line in full-screen mode (H 165; 243), and in 2-cell
//! mode keeps the last block's pair — which is what the partial block at the left of the
//! next line takes (in V-blank, or with the display off, it latches words 0 and 1 at H 220).

/// A frame: `width` × `height` pixels of [pixel] values, row by row.
pub struct Frame {
  width: i64,
  height: i64,
  pixels: []u16,
}

/// Intensities, as a pixel's bits 13–12.
pub const NORMAL: u16 = 0x0000
pub const SHADOW: u16 = 0x1000
pub const HIGHLIGHT: u16 = 0x2000

// ── A line ───────────────────────────────────────────────────────────────────

/// One layer's pixel: its colour index within CRAM (0–63; index 0 of any palette is
/// transparent) and its priority bit.
struct Dot {
  color: u8,
  high: bool,
}

let clear_dot = Dot { color: 0, high: false }

/// What the slot the beam has just reached does for the picture (called by [next_slot]):
/// the fetches for the line coming up, the latches, and two pixels of the line going out.
let render_slot = (vdp: mut Vdp) -> void => {
  let s = vdp.hslot
  let wide = h40(vdp)
  let fetching = vdp.phase != Blank && (vdp.regs[1] & 0x40) != 0
  let cell_scroll = (vdp.regs[11] & 0x04) != 0
  if (!cell_scroll && s == (if wide { 165 } else { 243 })) || (cell_scroll && !fetching && s == 220) {
    vdp.vscroll_latch[0] = vdp.vsram[0]
    vdp.vscroll_latch[1] = vdp.vsram[1]
  }
  if fetching {
    let blocks: u16 = if wide { 20 } else { 16 }
    if s == (if wide { 163 } else { 131 }) {
      let next = i64((vdp.vcounter + 1) & 0x1FF)
      let width = screen_width(vdp)
      if next < active_lines(vdp) { vdp.sprites_next = sprite_line(vdp, next, width) }
    } else if s == 244 {
      let y = i64(vdp.vcounter)
      vdp.line_hscroll[0] = horizontal_scroll(vdp, y, 0)
      vdp.line_hscroll[1] = horizontal_scroll(vdp, y, 1)
    } else if s == 249 || s == 253 {
      fetch_block(vdp, -1, if s == 249 { 0 } else { 1 })
    } else if s >= 1 && s < 8 * blocks && ((s & 7) == 1 || (s & 7) == 5) {
      fetch_block(vdp, i64(s >> 3), if (s & 7) == 1 { 0 } else { 1 })
    }
  }
  if s == 6 && vdp.phase == Active && i64(vdp.vcounter) < active_lines(vdp) {
    vdp.row = i64(vdp.vcounter)
    vdp.row_width = screen_width(vdp)
    vdp.sprites_row = vdp.sprites_next
  }
  if vdp.row >= 0 && s >= 6 {
    let left = 2 * i64(s - 6) - 13
    put_pixel(vdp, left)
    put_pixel(vdp, left + 1)
  }
}

/// Pixel x of the row going out, if it is on the screen; the row, and after the last row
/// the frame, complete with the last pixel.
let put_pixel = (vdp: mut Vdp, x: i64) -> void => {
  if x < 0 || x >= vdp.row_width { return }
  vdp.drawing[vdp.row * vdp.row_width + x] = pixel_at(vdp, x)
  if x < vdp.row_width - 1 { return }
  let last = vdp.row == active_lines(vdp) - 1
  vdp.drawing_width = vdp.row_width
  vdp.row = -1
  if last { complete_frame(vdp) }
}

/// A CRAM write as its slot takes it: the pixel going out, the second of the slot's two,
/// shows the colour written.
let cram_dot = (vdp: mut Vdp, color: u16) -> void => {
  if vdp.row < 0 || vdp.hslot < 6 { return }
  let x = 2 * i64(vdp.hslot - 6) - 12
  if x >= 0 && x < vdp.row_width {
    vdp.drawing[vdp.row * vdp.row_width + x] = color & 0x0EEE
  }
}

/// Pixel x of the row going out: the frontmost opaque one of — high sprite, high plane A
/// (or window), high plane B, low sprite, low A, low B — else the background colour; in
/// shadow/highlight mode with an intensity as well ([compose_shadow]). The leftmost 8
/// pixels are the background when register 0 bit 5 asks, and every pixel while the display
/// is off.
let pixel_at = pure (vdp: Vdp, x: i64) -> u16 => {
  let background = u16(vdp.cram[i64(vdp.regs[7] & 0x3F)] & 0x0EEE)
  if (vdp.regs[1] & 0x40) == 0 { return background }
  let shadow_mode = (vdp.regs[12] & 0x08) != 0
  if (vdp.regs[0] & 0x20) != 0 && x < 8 {
    // In shadow/highlight mode the blanked column is the backdrop shadowed.
    return if shadow_mode { background | SHADOW } else { background }
  }
  let sprite = if x < vdp.sprites_row.len() { vdp.sprites_row[x] } else { clear_dot }
  compose(
    vdp,
    sprite,
    plane_dot(vdp, x, 0),
    plane_dot(vdp, x, 1),
    background,
    shadow_mode
  )
}

let screen_width = pure (vdp: Vdp) -> i64 => if h40(vdp) { 320 } else { 256 }

let active_lines = pure (vdp: Vdp) -> i64 =>
  if (vdp.regs[1] & 0x08) != 0 { 240 } else { 224 }

/// The pixel the layers make, by priority (and, in shadow/highlight mode, intensity).
let compose = pure (
  vdp: Vdp,
  s: Dot,
  a: Dot,
  b: Dot,
  background: u16,
  shadow_mode: bool
) -> u16 => {
  if !shadow_mode {
    let d = frontmost(s, a, b)
    return if d.color == 0 { background } else { color_of(vdp, d.color) }
  }
  compose_shadow(vdp, s, a, b, background)
}

/// Shadow/highlight mode's pixel. Layers are chosen as without it — B, then A over it if its
/// priority is at least the shown pixel's, then the sprite likewise (the backdrop counting
/// as low) — while an intensity is carried beside the choice, in three steps (shadow,
/// normal, highlight):
///
/// - it starts **normal if either plane's tile is high priority** there, opaque or not, and
///   shadow if both are low;
/// - a sprite pixel that would be on top: palette 3's colour 14 (3E) is not drawn and lifts
///   the intensity a step, colour 15 (3F) is not drawn and drops it to shadow; any other
///   colour 14 (0E, 1E, 2E) is drawn at normal; any other colour is drawn at normal if the
///   sprite is high priority, and leaves the intensity as it was if not.
///
/// So an operator under a high plane pixel does nothing, since it is not on top; the oracle
/// settled this (genvdp.txt had the operators' colours the other way round).
let compose_shadow = pure (vdp: Vdp, s: Dot, a: Dot, b: Dot, background: u16) -> u16 => {
  var shown = clear_dot
  if b.color != 0 { shown = b }
  if a.color != 0 && (a.high || !shown.high) { shown = a }
  var level = if a.high || b.high { 1 } else { 0 }
  if s.color != 0 && (s.high || !shown.high) {
    if s.color == 0x3E {
      level += 1
    } else if s.color == 0x3F {
      level = 0
    } else {
      shown = s
      if (s.color & 0x0F) == 0x0E {
        level = 1
      } else if s.high {
        level = 1
      }
    }
  }
  let base = if shown.color == 0 { background } else { color_of(vdp, shown.color) }
  base | (if level >= 2 { HIGHLIGHT } else if level == 1 { NORMAL } else { SHADOW })
}

/// The frontmost opaque dot of sprite, A and B by priority; transparent if none is.
let frontmost = pure (s: Dot, a: Dot, b: Dot) -> Dot => {
  if s.color != 0 && s.high { return s }
  if a.color != 0 && a.high { return a }
  if b.color != 0 && b.high { return b }
  if s.color != 0 { return s }
  if a.color != 0 { return a }
  if b.color != 0 { return b }
  clear_dot
}

let color_of = pure (vdp: Vdp, index: u8) -> u16 => vdp.cram[i64(index & 0x3F)] & 0x0EEE

// ── Planes ───────────────────────────────────────────────────────────────────
//
// **A plane is drawn as the VDP fetches it**: in 2-cell (16-pixel) blocks, one more than
// the screen holds — a partial block first, at the left — each block taking its own column's
// vertical scroll, the whole strip then shifted right by the fine horizontal scroll
// (`h & 15`), so a pixel's first `fine` columns come from the block before it. The window
// takes plane A's place a block at a time, and is not shifted; the first plane A block after
// a left window has no block before it to draw from, and wraps within itself instead (the
// hardware's "window bug"). Drawing plane pixels one by one from the scrolled position gets
// every one of these wrong, which is how the oracle found them.

/// Block k of line L fetched for plane `which` (0 A, 1 B; k = -1, the partial block, to
/// 19, or 15 in 32-cell mode): its 16 pixels at the vertical scroll latched now — and, for
/// plane A, whether the window has the block, and its pixels if so.
let fetch_block = (vdp: mut Vdp, k: i64, which: i64) -> void => {
  let y = i64(vdp.vcounter)
  if (vdp.regs[11] & 0x04) != 0 {
    if k >= 0 {
      vdp.vscroll_latch[which] = vdp.vsram[k * 2 + which]
    } else if which == 0 {
      // The partial block has no column of its own: in 40-cell mode both planes take the
      // AND of what the latches hold from the last block fetched (the model-1 behaviour
      // the oracle emulates; MD2 VA4 and later take column 0's), in 32-cell mode zero.
      let both = if h40(vdp) { vdp.vscroll_latch[0] & vdp.vscroll_latch[1] } else { 0 }
      vdp.vscroll_latch[0] = both
      vdp.vscroll_latch[1] = both
    }
  }
  // The block's two cells: plane pixels 16k - (hscroll & ~15) onward, on the row the
  // vertical scroll makes — a name-table entry and a pattern row each.
  let columns = plane_cells(vdp.regs[16] & 3)
  let rows = plane_cells((vdp.regs[16] >> 4) & 3)
  let base = if which == 0 { plane_a_base(vdp) } else { plane_b_base(vdp) }
  let py = (y + i64(vdp.vscroll_latch[which] & 0x3FF)) & (rows * 8 - 1)
  for cell in 0..<2 {
    let px = (16 * k - (vdp.line_hscroll[which] & ~15) + cell * 8) & (columns * 8 - 1)
    let entry = vram_entry(vdp, base + ((py >> 3) * columns + (px >> 3)) * 2)
    let row = if (entry & 0x1000) != 0 { 7 - (py & 7) } else { py & 7 }
    let pattern_row = i64(entry & 0x07FF) * 32 + row * 4
    let palette = u8(((entry >> 13) & 3) << 4)
    let high = (entry & 0x8000) != 0
    for c in 0..<8 {
      let col = if (entry & 0x0800) != 0 { 7 - c } else { c }
      let byte = vdp.vram[(pattern_row + (col >> 1)) & 0xFFFF]
      let pixel = if (col & 1) == 0 { byte >> 4 } else { byte & 0x0F }
      let dot = Dot { color: if pixel == 0 { 0 } else { palette | pixel }, high: high }
      let at = (k + 1) * 16 + cell * 8 + c
      if which == 0 { vdp.strip_a[at] = dot } else { vdp.strip_b[at] = dot }
    }
  }
  if which == 1 || k < 0 { return }
  vdp.window_blocks[k] = window_block(vdp, k, y)
  if vdp.window_blocks[k] {
    for p in 0..<16 { vdp.window_dots[k * 16 + p] = window_dot(vdp, k * 16 + p, y) }
  }
}

/// Plane `which`'s (0 A, 1 B) dot at pixel x of the row going out, from the blocks
/// fetched, plane A with the window in its place.
let plane_dot = pure (vdp: Vdp, x: i64, which: i64) -> Dot => {
  let fine = vdp.line_hscroll[which] & 15
  let k = x >> 4
  let i = x & 15
  if which == 1 { return vdp.strip_b[(k + 1) * 16 + i - fine] }
  if vdp.window_blocks[k] { return vdp.window_dots[x] }
  // The block after a left window: its first `fine` pixels wrap within itself.
  if k > 0 && vdp.window_blocks[k - 1] { return vdp.strip_a[(k + 1) * 16 + ((i - fine) & 15)] }
  vdp.strip_a[(k + 1) * 16 + i - fine]
}

/// The window's dot at screen (x, y): its own name table, never scrolled, 64 cells wide in
/// 40-cell mode and 32 in 32-cell.
let window_dot = pure (vdp: Vdp, x: i64, y: i64) -> Dot => {
  let columns = if h40(vdp) { 64 } else { 32 }
  let entry = vram_entry(vdp, window_base(vdp) + ((y >> 3) * columns + (x >> 3)) * 2)
  tile_dot(vdp, entry, x & 7, y & 7)
}

/// Whether block k (a 16-pixel column) of line y is the window's: every block on the lines
/// register 18 gives it (above or below its row), or else the blocks register 17 gives it
/// (left or right of its column, counted in blocks).
let window_block = pure (vdp: Vdp, k: i64, y: i64) -> bool => {
  let row = i64(vdp.regs[18] & 0x1F) * 8
  let in_rows = if (vdp.regs[18] & 0x80) != 0 { y >= row } else { y < row }
  if in_rows { return true }
  let column = i64(vdp.regs[17] & 0x1F)
  if (vdp.regs[17] & 0x80) != 0 { k >= column } else { k < column }
}

/// A name-table entry's pixel at (col, row) within its tile: priority (bit 15), palette
/// (14–13), vertical and horizontal flip (12, 11), pattern (10–0; 32 bytes of 4-bit pixels,
/// the left pixel of each pair in the high nibble).
let tile_dot = pure (vdp: Vdp, entry: u16, col: i64, row: i64) -> Dot => {
  let r = if (entry & 0x1000) != 0 { 7 - row } else { row }
  let c = if (entry & 0x0800) != 0 { 7 - col } else { col }
  let pixel = pattern_pixel(vdp, i64(entry & 0x07FF), c, r)
  if pixel == 0 { return Dot { color: 0, high: (entry & 0x8000) != 0 } }
  Dot { color: u8(((entry >> 13) & 3) << 4) | pixel, high: (entry & 0x8000) != 0 }
}

let pattern_pixel = pure (vdp: Vdp, tile: i64, c: i64, r: i64) -> u8 => {
  let byte = vdp.vram[(tile * 32 + r * 4 + (c >> 1)) & 0xFFFF]
  if (c & 1) == 0 { byte >> 4 } else { byte & 0x0F }
}

/// The horizontal scroll of plane `which` (0 A, 1 B) on line `y`, by register 11's mode:
/// one value for the screen, one per 8-line cell row, one per line — or the first eight
/// lines' values repeating, the mode Motorola's table calls invalid.
let horizontal_scroll = pure (vdp: Vdp, y: i64, which: i64) -> i64 => {
  let base = i64(vdp.regs[13] & 0x3F) << 10
  let offset = match vdp.regs[11] & 3 {
    0 => 0,
    1 => (y & 7) * 4,
    2 => (y & 0xF8) * 4,
    _ => y * 4,
  }
  i64(vram_entry(vdp, base + offset + which * 2) & 0x3FF)
}

/// A plane's size in cells, from its two register-16 bits: 32, 64, or 128 (`11`; `10` is
/// not a size, taken as 32).
let plane_cells = pure (bits: u8) -> i64 => match bits {
  1 => 64,
  3 => 128,
  _ => 32,
}

let plane_a_base = pure (vdp: Vdp) -> i64 => i64(vdp.regs[2] & 0x38) << 10

let plane_b_base = pure (vdp: Vdp) -> i64 => i64(vdp.regs[4] & 0x07) << 13

/// The window's name table: register 3's bits 5–1, bit 1 ignored in 40-cell mode.
let window_base = pure (vdp: Vdp) -> i64 => {
  let mask: u8 = if h40(vdp) { 0x3C } else { 0x3E }
  i64(vdp.regs[3] & mask) << 10
}

/// 40-cell mode: register 12's RS0 and RS1 (bits 0 and 7).
let h40 = pure (vdp: Vdp) -> bool => (vdp.regs[12] & 0x81) != 0

/// The VRAM word at an even byte address, wrapping at 64 KB.
let vram_entry = pure (vdp: Vdp, address: i64) -> u16 => {
  let at = address & 0xFFFE
  (u16(vdp.vram[at]) << 8) | u16(vdp.vram[at + 1])
}

// ── Sprites ──────────────────────────────────────────────────────────────────

/// Line `y`'s sprite dots, one per screen pixel: the sprite list followed from entry 0
/// through its links, each sprite on the line drawn where no earlier one already drew —
/// the list's order is sprite priority. At most 20 sprites and 320 pixels of them a line in
/// 40-cell mode (16 and 256 in 32-cell), and 80 sprites in the list (64). A sprite at
/// x = 0 masks the rest of the line's sprites once another sprite has been found on it.
let sprite_line = (vdp: Vdp, y: i64, width: i64) -> []Dot => {
  var dots: []Dot = [clear_dot; width]
  let wide = h40(vdp)
  let max_list = if wide { 80 } else { 64 }
  let max_line = if wide { 20 } else { 16 }
  let base = i64(vdp.regs[5] & (if wide { 0x7E } else { 0x7F })) << 9
  var link = 0
  var found = 0
  var pixels_left = width
  var masked = false
  for _ in 0..<max_list {
    let at = base + link * 8
    let top = i64(vram_entry(vdp, at) & 0x1FF) - 128
    let size = vdp.vram[(at + 2) & 0xFFFF]
    let cells_wide = i64((size >> 2) & 3) + 1
    let cells_high = i64(size & 3) + 1
    if y >= top && y < top + cells_high * 8 {
      if found == max_line { break }
      found += 1
      let attributes = vram_entry(vdp, at + 4)
      let sx = i64(vram_entry(vdp, at + 6) & 0x1FF)
      if sx == 0 && found > 1 { masked = true }
      if !masked {
        draw_sprite(
          vdp,
          dots,
          y - top,
          sx - 128,
          cells_wide,
          cells_high,
          attributes,
          pixels_left
        )
      }
      pixels_left -= cells_wide * 8
      if pixels_left <= 0 { break }
    }
    link = i64(vdp.vram[(at + 3) & 0xFFFF] & 0x7F)
    if link == 0 || link >= max_list { break }
  }
  dots
}

/// One sprite's row `row` (from its top) drawn at screen x `left`, its cells arranged
/// column by column (tile + column × height + row), flipped as its attributes say; at most
/// `budget` of its pixels drawn, the line's remaining sprite pixels.
let draw_sprite = (
  vdp: Vdp,
  dots: mut []Dot,
  row: i64,
  left: i64,
  cells_wide: i64,
  cells_high: i64,
  attributes: u16,
  budget: i64
) -> void => {
  let vflip = (attributes & 0x1000) != 0
  let hflip = (attributes & 0x0800) != 0
  let r = if vflip { cells_high * 8 - 1 - row } else { row }
  let high = (attributes & 0x8000) != 0
  let palette = u8(((attributes >> 13) & 3) << 4)
  let first_tile = i64(attributes & 0x07FF)
  let span = cells_wide * 8
  let drawn = if budget < span { budget } else { span }
  for i in 0..<drawn {
    let x = left + i
    if x < 0 || x >= dots.len() || dots[x].color != 0 { continue }
    let c = if hflip { span - 1 - i } else { i }
    let tile = first_tile + (c >> 3) * cells_high + (r >> 3)
    let pixel = pattern_pixel(vdp, tile & 0x7FF, c & 7, r & 7)
    if pixel != 0 { dots[x] = Dot { color: palette | pixel, high: high } }
  }
}

// ── The frame ────────────────────────────────────────────────────────────────

/// The widest frame, which the frame in progress is sized for.
const MAX_PIXELS: i64 = 320 * 240

/// The last row's last pixel has gone out: the frame is complete, and shown.
let complete_frame = (vdp: mut Vdp) -> void => {
  let height = active_lines(vdp)
  let width = vdp.drawing_width
  vdp.shown = Frame {
    width: width,
    height: height,
    pixels: vdp.drawing.slice(0, width * height)
  }
  vdp.frames += 1
}
