// romtest — ROM files as dumped, read back as the ROM images inside them: raw, SMD, split
// SMD and MGD (made here from a known image by the copier's layout, written out
// independently of `rom_image`'s reading of it); the names a split image's next part is
// looked for by; and which of a zip archive's files are the ROM.
//
//   build/romtest        prints each failure, then a verdict; exits 1 on any

import genesis.{ rom_image, roms_in_zip, next_part_path }
import std.compress.{ crc32 }

let main = () -> u8 => {
  var failed = 0
  // Two whole blocks and a short one, so the last block's own half is exercised.
  let image = test_image(2 * 0x4000 + 7232)
  failed += expect_image("raw image", [image], image)
  failed += expect_image("SMD image", [smd_file(image, 0)], image)
  failed += expect_image("SMD image of whole blocks", [smd_file(test_image(0x8000), 0)], test_image(0x8000))
  // The magic bytes with 3–7 not zero is not the copier's header: the file is raw.
  var not_smd = smd_file(image, 0)
  not_smd[5] = 1
  failed += expect_image("near-SMD header", [not_smd], not_smd)
  failed += mgd_images()
  failed += split_images()
  failed += part_names()
  failed += zipped()
  if failed == 0 {
    println("romtest: all passed")
    return 0
  }
  println("romtest: ${failed} failed")
  1
}

// ── MGD images ───────────────────────────────────────────────────────────────

/// An MGD file read back, with "SEGA" at 100 or " SEGA" at 101; and a raw image that reads
/// "SEGA" neither way kept as it is, not taken for MGD.
let mgd_images = () -> i64 => {
  let image = test_image(0x20000)
  var failed = expect_image("MGD image", [mgd_file(image)], image)
  var spaced = test_image(0x20000)
  spaced[0x100] = 0x20
  spaced[0x101] = 0x53
  spaced[0x102] = 0x45
  spaced[0x103] = 0x47
  spaced[0x104] = 0x41
  failed += expect_image("MGD image, \" SEGA\"", [mgd_file(spaced)], spaced)
  var unsigned = test_image(0x20000)
  unsigned[0x100] = 0
  failed += expect_image("raw image without \"SEGA\"", [unsigned], unsigned)
  failed
}

/// `image` as the Multi Game Doctor writes it: no header, the odd addresses' bytes and then
/// the even addresses'.
let mgd_file = pure (image: []u8) -> []u8 => {
  var file: []u8 = []
  var a = 1
  while a < image.len() {
    file.push(image[a])
    a += 2
  }
  a = 0
  while a < image.len() {
    file.push(image[a])
    a += 2
  }
  file
}

// ── Split SMD images ─────────────────────────────────────────────────────────

/// A 5-block image in three parts — two blocks, two, then one short — read whole; and
/// refused with a part missing, out of order, or ending early, or with a raw file given as
/// a part.
let split_images = () -> i64 => {
  let image = test_image(4 * 0x4000 + 5000)
  let part1 = smd_file(image.slice(0, 0x8000), 0x40)
  let part2 = smd_file(image.slice(0x8000, 0x10000), 0x40)
  let part3 = smd_file(image.slice(0x10000, image.len()), 0)
  var failed = expect_image("split SMD image", [part1, part2, part3], image)
  failed += expect_refused("split SMD image, last part missing", [part1, part2])
  failed += expect_refused("split SMD image from its second part", [part2, part3])
  failed += expect_refused("split SMD image, first part given alone", [part1])
  failed += expect_refused("split SMD image ending early", [smd_file(image.slice(0, 0x8000), 0), part3])
  failed += expect_refused("raw file as a part", [part1, image.slice(0x8000, image.len())])
  failed += expect_refused("raw file with parts after it", [image, part3])
  failed
}

// ── Part names ───────────────────────────────────────────────────────────────

let part_names = () -> i64 => {
  let cases: [](string, string) = [
    ("game.1", "game.2"),
    ("roms/game.009", "roms/game.010"),
    ("game.99", "game.100"),
    ("sf2md1.smd", "sf2md2.smd"),
    ("roms.2/sf2md9.SMD", "roms.2/sf2md10.SMD"),
    ("sf2a.smd", "sf2b.smd"),
    ("roms/SF2A.SMD", "roms/SF2B.SMD"),
    ("dir.1/game", "dir.1/gamf"),
  ]
  var failed = 0
  for case in cases {
    let (path, want) = case
    let got = next_part_path(path)
    if got != Some(want) {
      println("next part after ${path}: ${got.unwrap_or("none")}, want ${want}")
      failed += 1
    }
  }
  // Nothing to count on: a last letter z, no name at all.
  for path in ["gamez.smd", "roms/", ""] {
    if let Some(got) = next_part_path(path) {
      println("next part after \"${path}\": ${got}, want none")
      failed += 1
    }
  }
  failed
}

// ── Zip archives ─────────────────────────────────────────────────────────────

/// The ROM beside a readme and a directory; a lone file with no extension; a split image's
/// parts, stored out of order; and an archive of two ROMs, refused.
let zipped = () -> i64 => {
  let image = test_image(4 * 0x4000 + 5000)
  var failed = expect_zip(
    "zipped ROM",
    zip_file([("docs/", []), ("readme.txt", [0x68, 0x69]), ("docs/game.bin", image)]),
    image
  )
  failed += expect_zip("zipped file with no extension", zip_file([("game", image)]), image)
  let part1 = smd_file(image.slice(0, 0x8000), 0x40)
  let part2 = smd_file(image.slice(0x8000, 0x10000), 0x40)
  let part3 = smd_file(image.slice(0x10000, image.len()), 0)
  failed += expect_zip(
    "zipped split SMD image",
    zip_file([("SF3.SMD", part3), ("readme.txt", [0x68]), ("SF1.SMD", part1), ("SF2.SMD", part2)]),
    image
  )
  match roms_in_zip(zip_file([("a.bin", image), ("b.bin", image)])) {
    Ok(_) => {
      println("zip of two ROMs: read, not refused")
      failed += 1
    },
    Err(_) => {},
  }
  failed
}

let expect_zip = (name: string, archive: []u8, want: []u8) -> i64 => match roms_in_zip(archive) {
  Ok(files) => expect_image(name, files, want),
  Err(why) => {
    println("${name}: refused as ${why}")
    1
  },
}

/// A zip archive of these entries, stored uncompressed: each one's local header and bytes,
/// then the central directory and its end record.
let zip_file = pure (entries: [](string, []u8)) -> []u8 => {
  var out: []u8 = []
  var directory: []u8 = []
  for entry in entries {
    let (name, data) = entry
    let offset = out.len()
    var name_bytes: []u8 = []
    for c in name { name_bytes.push(u8(i64(c))) }
    let crc = i64(crc32(data))
    put_le(out, 0x04034B50, 4)
    for v in [20, 0, 0, 0, 0] { put_le(out, v, 2) }
    for v in [crc, data.len(), data.len()] { put_le(out, v, 4) }
    put_le(out, name_bytes.len(), 2)
    put_le(out, 0, 2)
    for b in name_bytes { out.push(b) }
    for b in data { out.push(b) }
    put_le(directory, 0x02014B50, 4)
    for v in [20, 20, 0, 0, 0, 0] { put_le(directory, v, 2) }
    for v in [crc, data.len(), data.len()] { put_le(directory, v, 4) }
    for v in [name_bytes.len(), 0, 0, 0, 0] { put_le(directory, v, 2) }
    put_le(directory, 0, 4)
    put_le(directory, offset, 4)
    for b in name_bytes { directory.push(b) }
  }
  let directory_at = out.len()
  for b in directory { out.push(b) }
  put_le(out, 0x06054B50, 4)
  for v in [0, 0, entries.len(), entries.len()] { put_le(out, v, 2) }
  put_le(out, directory.len(), 4)
  put_le(out, directory_at, 4)
  put_le(out, 0, 2)
  out
}

let put_le = (bytes: mut []u8, value: i64, size: i64) -> void => {
  for i in 0..<size { bytes.push(u8((value >> (8 * i)) & 0xFF)) }
}

/// `size` bytes no two neighbours of which are alike, "SEGA" where a header says it.
let test_image = pure (size: i64) -> []u8 => {
  var bytes: []u8 = [0; size]
  for i in 0..<size { bytes[i] = u8((i * 7 + (i >> 8) * 13) & 0xFF) }
  bytes[0x100] = 0x53
  bytes[0x101] = 0x45
  bytes[0x102] = 0x47
  bytes[0x103] = 0x41
  bytes
}

/// `image` as the SMD copier writes it: the 512-byte header (`split` in byte 2), then each
/// 16 KB block's odd-address bytes followed by its even-address ones.
let smd_file = pure (image: []u8, split: u8) -> []u8 => {
  var file: []u8 = [0; 512]
  file[0] = u8((image.len() + 0x3FFF) / 0x4000)
  file[1] = 0x03
  file[2] = split
  file[8] = 0xAA
  file[9] = 0xBB
  file[10] = 0x06
  var start = 0
  while start < image.len() {
    let end = if start + 0x4000 < image.len() { start + 0x4000 } else { image.len() }
    var a = start + 1
    while a < end {
      file.push(image[a])
      a += 2
    }
    a = start
    while a < end {
      file.push(image[a])
      a += 2
    }
    start = end
  }
  file
}

let expect_image = (name: string, files: [][]u8, want: []u8) -> i64 => match rom_image(files) {
  Ok(got) => {
    if got == want { return 0 }
    println("${name}: ${got.len()} bytes read back, differing from the ${want.len()} wanted")
    1
  },
  Err(why) => {
    println("${name}: refused as ${why}")
    1
  },
}

let expect_refused = (name: string, files: [][]u8) -> i64 => match rom_image(files) {
  Ok(_) => {
    println("${name}: read, not refused")
    1
  },
  Err(_) => 0,
}
