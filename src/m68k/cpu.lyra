module m68k
//! The Motorola 68000, bus cycle by bus cycle.
//!
//! **What is modelled is what the pins show.** Every instruction is a sequence of word and
//! byte accesses and idle cycles on a [Bus], in the order and with the timing the real chip
//! produces, including the **prefetch queue**: the opcode being executed (IRD) and the word
//! after it (IRC) are already on chip when an instruction starts, and each instruction ends
//! by fetching the next. Games observe all three — self-modifying code sees the prefetch,
//! raster effects depend on the timing, and hardware registers on the Genesis react to the
//! exact access sequence — so the core is checked against the SingleStepTests suite, which
//! records every bus transaction of every test (`tests/`).
//!
//! **Time lives in the bus.** Each access costs 4 cycles plus whatever wait states the bus
//! adds (the Genesis VDP and Z80 buses do); [Bus.idle] is cycles with no access. The CPU keeps
//! no clock of its own, so the scheduler that interleaves the chips owns the one clock.

/// The 68000's registers and prefetch queue.
pub struct Cpu {
  /// D0–D7.
  d: [8]u32,
  /// A0–A7. A7 is whichever stack pointer the mode selects; the other is [inactive_sp].
  a: [8]u32,
  /// The stack pointer not in use: the user one (USP) in supervisor mode, the supervisor
  /// one (SSP) in user mode.
  inactive_sp: u32,
  /// The status register: the condition codes in the low byte, the system byte above.
  sr: u16,
  /// The address of the opcode in [ird].
  pc: u32,
  /// The opcode being executed.
  ird: u16,
  /// The word after it, already fetched: the first extension word, or the next opcode.
  irc: u16,
  /// An address error is pending: the instruction faulted, and [step] runs exception 3
  /// once it has run to its end without the bus (`access.lyra`).
  faulted: bool,
  /// The faulted access's address and its status-word bits (R/W, I/N, function code).
  fault_address: u32,
  fault_status: u16,
  /// The interrupt level on the IPL pins when the chip last looked: at every instruction
  /// fetch ([sample_interrupt_level]), so an interrupt raised after an instruction's last
  /// fetch is seen only after the next instruction.
  ipl: u8,
  /// Level 7 rose since it was last taken. Level 7 cannot be masked and is taken on the
  /// edge, not the level: once per rise, however long it is held.
  nmi: bool,
  /// STOP is in effect: no instructions run until an interrupt is taken.
  stopped: bool,
}

/// What the 68000 is wired to. Each method is one bus cycle — or, for `idle`, cycles with
/// nothing on the bus — so an implementation sees exactly the sequence the chip puts on its
/// pins. `fc` is the function code: [FC_USER_DATA], [FC_USER_PROGRAM],
/// [FC_SUPERVISOR_DATA], [FC_SUPERVISOR_PROGRAM], or [FC_INTERRUPT_ACKNOWLEDGE].
///
/// `test_and_set_byte` is TAS's read-modify-write cycle, the one access the chip makes
/// indivisibly: read the byte, write it back with bit 7 set, ten cycles, and answer the byte
/// read. It is the bus's to honour — the Genesis never completes the write.
///
/// `interrupt_level` is the IPL pins now, 0 (none) to 7; it takes no time.
/// `acknowledge_interrupt` is the interrupt-acknowledge cycle for a level (function code
/// 7), with whatever time it takes, answering the vector number: a device's own, 24 +
/// level for an autovector (VPA, which is how the Genesis answers, synchronised to the E
/// clock), or 24, the spurious interrupt, for a bus error.
pub trait Bus {
  read_word: (mut Self, u32, u8) -> u16
  read_byte: (mut Self, u32, u8) -> u8
  write_word: (mut Self, u32, u8, u16) -> void
  write_byte: (mut Self, u32, u8, u8) -> void
  test_and_set_byte: (mut Self, u32, u8) -> u8
  interrupt_level: (mut Self) -> u8
  acknowledge_interrupt: (mut Self, u8) -> u32
  idle: (mut Self, i64) -> void
}

pub const FC_USER_DATA: u8 = 1
pub const FC_USER_PROGRAM: u8 = 2
pub const FC_SUPERVISOR_DATA: u8 = 5
pub const FC_SUPERVISOR_PROGRAM: u8 = 6
pub const FC_INTERRUPT_ACKNOWLEDGE: u8 = 7

/// The status register's bits.
pub const SR_C: u16 = 0x0001
pub const SR_V: u16 = 0x0002
pub const SR_Z: u16 = 0x0004
pub const SR_N: u16 = 0x0008
pub const SR_X: u16 = 0x0010
pub const SR_S: u16 = 0x2000
pub const SR_T: u16 = 0x8000

/// What became of one [step].
pub data Outcome =
  /// The instruction ran; IRD holds the next one.
  Executed
  /// Not a 68000 instruction ([is_legal]): exception 4 has been taken, or 10 or 11 for an
  /// opcode in line A or F, and IRD holds the handler's first instruction.
  | Illegal(u16)
  /// An interrupt at this level was taken instead of an instruction; IRD holds the
  /// handler's first.
  | Interrupted(u8)
  /// STOP is in effect and no interrupt came: two cycles passed, nothing ran.
  | Stopped

/// Take a pending interrupt, or execute the instruction in IRD, leaving the next one there.
/// Stopped, wait two cycles for an interrupt instead.
pub let step<b> where b: Bus = (cpu: mut Cpu, bus: mut b) -> Outcome => {
  if cpu.stopped { sample_interrupt_level(cpu, bus) }
  let level = pending_interrupt(cpu)
  if level != 0 {
    take_interrupt(cpu, bus, level)
    if cpu.faulted { address_error(cpu, bus, cpu.ird) }
    return Interrupted(level)
  }
  if cpu.stopped {
    bus.idle(2)
    return Stopped
  }
  let op = cpu.ird
  if !is_legal(op) {
    illegal_instruction(cpu, bus, op)
    return Illegal(op)
  }
  let outcome = execute(cpu, bus, op)
  if cpu.faulted { address_error(cpu, bus, op) }
  outcome
}

/// Decode and run one opcode.
let execute<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  match op >> 12 {
    0x0 => immediate(cpu, bus, op),
    0x1 | 0x2 | 0x3 => move_family(cpu, bus, op),
    0x4 => miscellaneous(cpu, bus, op),
    0x5 => quick_or_condition(cpu, bus, op),
    0x6 => branch(cpu, bus, op),
    0x7 => if (op & 0x0100) == 0 { moveq(cpu, bus, op) } else { undecoded(cpu, bus, op) },
    0x8 => arith_group(cpu, bus, op, Or),
    0x9 => arith_group(cpu, bus, op, Sub),
    0xB => cmp_eor_group(cpu, bus, op),
    0xC => arith_group(cpu, bus, op, And),
    0xD => arith_group(cpu, bus, op, Add),
    0xE => shift_group(cpu, bus, op),
    _ => undecoded(cpu, bus, op),
  }
}

/// The user stack pointer, wherever it is kept.
pub let usp = pure (cpu: Cpu) -> u32 =>
  if supervisor(cpu) { cpu.inactive_sp } else { cpu.a[7] }

/// The supervisor stack pointer, wherever it is kept.
pub let ssp = pure (cpu: Cpu) -> u32 =>
  if supervisor(cpu) { cpu.a[7] } else { cpu.inactive_sp }

/// A CPU in the given state — what a test, a save state or a reset starts from. `usp` and
/// `ssp` are placed by `sr`'s S bit.
pub let cpu_with = pure (
  d: [8]u32,
  a0_a6: [7]u32,
  usp: u32,
  ssp: u32,
  sr: u16,
  pc: u32,
  ird: u16,
  irc: u16
) -> Cpu => {
  let is_supervisor = (sr & SR_S) != 0
  let a7 = if is_supervisor { ssp } else { usp }
  let a: [8]u32 = #[
    a0_a6[0],
    a0_a6[1],
    a0_a6[2],
    a0_a6[3],
    a0_a6[4],
    a0_a6[5],
    a0_a6[6],
    a7
  ]
  Cpu {
    d: d,
    a: a,
    inactive_sp: if is_supervisor { usp } else { ssp },
    sr: sr,
    pc: pc,
    ird: ird,
    irc: irc,
    faulted: false,
    fault_address: 0,
    fault_status: 0,
    ipl: 0,
    nmi: false,
    stopped: false,
  }
}

// ── Instructions ─────────────────────────────────────────────────────────────

/// NOP: 4 cycles, all of them the prefetch.
let nop<b> where b: Bus = (cpu: mut Cpu, bus: mut b) -> Outcome => {
  prefetch(cpu, bus)
  Executed
}

/// MOVEQ #d8, Dn: the byte sign-extended into all 32 bits. N and Z from the result, V and
/// C cleared, X untouched. 4 cycles, all of them the prefetch.
let moveq<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  let value = u32(i32(i8(op & 0xFF)))
  cpu.d[i64((op >> 9) & 7)] = value
  set_logic_flags(cpu, value, 0x80000000)
  prefetch(cpu, bus)
  Executed
}

/// Group 4, the miscellany, as far as it is implemented: NOP, the returns, TRAP, TRAPV,
/// RESET, MOVE USP, the SR and CCR moves, CHK, NBCD, NEGX, CLR, NEG, NOT, TST, TAS, SWAP,
/// EXT, LINK, UNLK, MOVEM, JMP, JSR, LEA, PEA.
let miscellaneous<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  match op {
    0x4E70 => return reset_peripherals(cpu, bus),
    0x4E71 => return nop(cpu, bus),
    0x4E72 => return stop(cpu, bus),
    0x4E73 => return return_from_exception(cpu, bus),
    0x4E75 => return return_from_subroutine(cpu, bus),
    0x4E76 => return trap_on_overflow(cpu, bus),
    0x4E77 => return return_and_restore(cpu, bus),
    _ => {},
  }
  let reg = source_reg(op)
  // By pattern alone: [step] has refused every operand the instruction does not allow, so
  // where two share a pattern, the register form is the one with ea mode 0.
  if (op & 0xFFF0) == 0x4E40 { return trap(cpu, bus, op) }
  if (op & 0xFFF8) == 0x4E50 { return link(cpu, bus, reg) }
  if (op & 0xFFF8) == 0x4E58 { return unlink(cpu, bus, reg) }
  if (op & 0xFFF0) == 0x4E60 { return move_user_stack(cpu, bus, op) }
  if (op & 0xFFF8) == 0x4840 { return swap_halves(cpu, bus, reg) }
  if (op & 0xFFF8) == 0x4880 { return extend_sign(cpu, bus, reg, WORD) }
  if (op & 0xFFF8) == 0x48C0 { return extend_sign(cpu, bus, reg, LONG) }
  if (op & 0xFB80) == 0x4880 { return move_multiple(cpu, bus, op) }
  if (op & 0xFFC0) == 0x40C0 { return move_from_status(cpu, bus, op) }
  if (op & 0xFFC0) == 0x44C0 { return move_to_status(cpu, bus, op, false) }
  if (op & 0xFFC0) == 0x46C0 { return move_to_status(cpu, bus, op, true) }
  if (op & 0xF1C0) == 0x4180 { return check_bounds(cpu, bus, op) }
  if (op & 0xF1C0) == 0x41C0 { return load_effective_address(cpu, bus, op) }
  if (op & 0xFFC0) == 0x4800 { return negate_bcd(cpu, bus, op) }
  if (op & 0xFFC0) == 0x4840 { return push_effective_address(cpu, bus, op) }
  if (op & 0xFFC0) == 0x4AC0 { return test_and_set(cpu, bus, op) }
  if (op & 0xFFC0) == 0x4E80 { return jump_subroutine(cpu, bus, op) }
  if (op & 0xFFC0) == 0x4EC0 { return jump(cpu, bus, op) }
  if is_unary(op) { return unary(cpu, bus, op) }
  undecoded(cpu, bus, op)
}

/// Group 5: ADDQ/SUBQ with a size, DBcc and Scc with size bits `11`.
let quick_or_condition<b> where b: Bus = (
  cpu: mut Cpu,
  bus: mut b,
  op: u16
) -> Outcome => {
  if ((op >> 6) & 3) == 3 { return set_or_decrement(cpu, bus, op) }
  add_sub_quick(cpu, bus, op)
}

/// Opcode groups 1–3: MOVE, or MOVEA when the destination is an address register (which a
/// byte move may not have).
let move_family<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  let size = move_size(op)
  if destination_mode(op) != 1 { return move(cpu, bus, op, size) }
  if size == BYTE { undecoded(cpu, bus, op) } else { movea(cpu, bus, op, size) }
}

// ── The machinery every instruction shares ───────────────────────────────────

/// The step every instruction ends with: IRC moves into IRD, and the word after it is
/// read into IRC. Four cycles.
let prefetch<b> where b: Bus = (cpu: mut Cpu, bus: mut b) -> void => {
  if cpu.faulted { return }
  cpu.ird = cpu.irc
  cpu.irc = cpu_read_word(cpu, bus, cpu.pc.wrapping_add(4), program_fc(cpu))
  cpu.pc = cpu.pc.wrapping_add(2)
}

/// N and Z from `value` (whose sign bit is `sign`), V and C cleared, X untouched: the flags
/// of MOVE, MOVEQ and the logical operations.
let set_logic_flags = (cpu: mut Cpu, value: u32, sign: u32) -> void => {
  if cpu.faulted { return }
  var sr = cpu.sr & ~(SR_N | SR_Z | SR_V | SR_C)
  if (value & sign) != 0 { sr = sr | SR_N }
  if (value & ((sign << 1).wrapping_sub(1))) == 0 { sr = sr | SR_Z }
  cpu.sr = sr
}

/// What the decoder does with an opcode it has no instruction for — which [step] never
/// lets it see, since [is_legal] refuses them first (`tests/legal.sh` checks every legal
/// opcode decodes). Should the two ever disagree, the chip's answer is the safe one: the
/// illegal-instruction exception.
let undecoded<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  illegal_instruction(cpu, bus, op)
  Illegal(op)
}

let supervisor = pure (cpu: Cpu) -> bool => (cpu.sr & SR_S) != 0

/// The function code of an instruction fetch in the current mode.
let program_fc = pure (cpu: Cpu) -> u8 =>
  if supervisor(cpu) { FC_SUPERVISOR_PROGRAM } else { FC_USER_PROGRAM }
