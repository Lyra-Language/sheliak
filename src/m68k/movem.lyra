module m68k
//! MOVEM, registers to and from consecutive memory, and MOVEP, a register to and from
//! alternate bytes (a peripheral's registers on an 8-bit half of the bus).
//!
//! **MOVEM's mask** is the first extension word, taken before the effective address's own:
//! bit 0 is D0 up to bit 15 A7 — except for -(An), where it runs the other way, bit 0 A7
//! down to bit 15 D0, since the registers are stored from the top. A word loaded into a
//! register is sign-extended to all 32 bits, data or address.
//!
//! **Loading reads one word more** than the registers need, at the address after the last,
//! and throws it away — the chip's own quirk, which the tests record on every one.

/// Group 4's MOVEM `0100 1d00 1s <ea>`: `d` (bit 10) set loads registers, `s` (bit 6) set
/// moves longs.
let move_multiple<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  let size = if (op & 0x0040) != 0 { LONG } else { WORD }
  let mask = take_extension(cpu, bus)
  let mode = source_mode(op)
  let reg = source_reg(op)
  if (op & 0x0400) != 0 { return load_registers(cpu, bus, mask, mode, reg, size) }
  if mode == 4 { return store_registers_predecrement(cpu, bus, mask, reg, size) }
  var addr = memory_address(locate(cpu, bus, mode, reg, size, true))
  for i in 0..<16 {
    if (mask & (u16(1) << u16(i))) != 0 {
      write_memory(cpu, bus, addr, size, register_value(cpu, i))
      addr = addr.wrapping_add(u32(size))
    }
  }
  prefetch(cpu, bus)
  Executed
}

/// MOVEM <ea>, list: the registers in mask order from ascending addresses, then the extra
/// read. (An)+ leaves An at the address after the last register loaded, not after the
/// extra read — or, when an odd An faults the first read, two past where it was (all 821
/// such tests, word and long).
let load_registers<b> where b: Bus = (
  cpu: mut Cpu,
  bus: mut b,
  mask: u16,
  mode: i64,
  reg: i64,
  size: i64
) -> Outcome => {
  let start = cpu.a[reg]
  var addr = if mode == 3 {
    start
  } else {
    memory_address(locate(cpu, bus, mode, reg, size, true))
  }
  for i in 0..<16 {
    if (mask & (u16(1) << u16(i))) != 0 {
      let raw = read_memory(cpu, bus, addr, size)
      let value = if size == WORD { sign_extend_word(u16(raw & 0xFFFF)) } else { raw }
      if !cpu.faulted { set_register(cpu, i, value) }
      addr = addr.wrapping_add(u32(size))
    }
  }
  cpu_read_word(cpu, bus, addr, data_fc(cpu))
  if mode == 3 { cpu.a[reg] = if cpu.faulted { start.wrapping_add(2) } else { addr } }
  prefetch(cpu, bus)
  Executed
}

/// MOVEM list, -(An): from A7 down to D0, each below the last; An ends at the lowest
/// address written. A long goes low word first, as MOVE's -(An) does.
let store_registers_predecrement<b> where b: Bus = (
  cpu: mut Cpu,
  bus: mut b,
  mask: u16,
  reg: i64,
  size: i64
) -> Outcome => {
  var addr = cpu.a[reg]
  let fc = data_fc(cpu)
  for i in 0..<16 {
    if (mask & (u16(1) << u16(i))) != 0 {
      let value = register_value(cpu, 15 - i)
      addr = addr.wrapping_sub(u32(size))
      if size == LONG {
        cpu_write_word(cpu, bus, addr.wrapping_add(2), fc, u16(value & 0xFFFF))
        cpu_write_word(cpu, bus, addr, fc, u16(value >> 16))
      } else {
        cpu_write_word(cpu, bus, addr, fc, u16(value & 0xFFFF))
      }
    }
  }
  if !cpu.faulted { cpu.a[reg] = addr }
  prefetch(cpu, bus)
  Executed
}

/// MOVEP `0000 ddd1 ms 001 aaa`, d16 in the extension word: Dn's bytes, high first, to or
/// from every other byte from (d16, An). `m` (bit 7) set stores; `s` (bit 6) set moves all
/// four bytes, clear the low two.
let move_peripheral<b> where b: Bus = (cpu: mut Cpu, bus: mut b, op: u16) -> Outcome => {
  let dn = destination_reg(op)
  let storing = (op & 0x0080) != 0
  let size = if (op & 0x0040) != 0 { LONG } else { WORD }
  let base = cpu.a[source_reg(op)].wrapping_add(sign_extend_word(take_extension(
    cpu,
    bus
  )))
  let fc = data_fc(cpu)
  var value: u32 = 0
  for i in 0..<size {
    let addr = base.wrapping_add(u32(2 * i))
    let shift = u32(8 * (size - 1 - i))
    if storing {
      cpu_write_byte(cpu, bus, addr, fc, u8((cpu.d[dn] >> shift) & 0xFF))
    } else {
      value = value | (u32(cpu_read_byte(cpu, bus, addr, fc)) << shift)
    }
  }
  if !storing && !cpu.faulted { write_data_register(cpu, dn, size, value) }
  prefetch(cpu, bus)
  Executed
}

/// Register `i` of MOVEM's numbering: D0–D7, then A0–A7.
let register_value = pure (cpu: Cpu, i: i64) -> u32 =>
  if i < 8 { cpu.d[i] } else { cpu.a[i - 8] }

let set_register = (cpu: mut Cpu, i: i64, value: u32) -> void => {
  if i < 8 { cpu.d[i] = value } else { cpu.a[i - 8] = value }
}

/// A located memory operand's address.
let memory_address = pure (at: Location) -> u32 => match at {
  InMemory(addr) => addr,
  Stepping(addr, _, _) => addr,
  _ => 0,
}
