// sheliak — the emulator in a window: a cartridge ROM run on the Genesis model, its
// picture shown and its sound played with SDL, the keyboard and gamepads as its pads.
//
//   build/sheliak ROM [PART …] [--pads 3]              play
//   build/sheliak ROM --frames N [--screenshot FILE] [--ppm FILE] [--wav FILE] [--save]
//                                                      run N frames and quit, saving the
//                                                      last: as SDL drew the window (BMP),
//                                                      and as the texels sent to it (PPM,
//                                                      which tests/vdp.sh compares with
//                                                      BlastEm); the sound of all N as a
//                                                      WAV — headless with
//                                                      SDL_VIDEODRIVER=dummy
//
// The pads are 6-button, as most players' are; `--pads 3` makes them the original 3-button
// pad, which a few early games need (they misread a 6-button one).
//
// Keys (pad 1): arrows; Z, X, C for A, B, C and A, S, D above them for X, Y, Z (the
// pad's two rows); Return for Start, Q for Mode. Escape quits; F toggles full screen (not
// F11, which macOS keeps for showing the desktop). A gamepad is a pad too — the first on
// port 1, the second on port 2: d-pad or left stick; the West, South and East face buttons
// for A, B and C (the Genesis's bottom row, left to right), the left shoulder, North and
// the right shoulder for X, Y and Z; Start and Back for Start and Mode.
//
// The ROM is a raw image or an SMD one (the copier's interleaved format), whatever the
// file's name (`.bin`, `.gen`, `.md`, `.smd`). A split SMD image's parts follow the first
// on the command line, or are found beside it by their names (`game.1` then `game.2`,
// `sf2md1.smd` then `sf2md2.smd`, `sf2a.smd` then `sf2b.smd`). A cartridge with save RAM keeps it in a
// `.srm` file beside the ROM (the ROM's name, its extension replaced): loaded at start,
// written every ten seconds while the game has changed it, and on quitting — BlastEm's
// `save.sram` format, a byte per byte of RAM. Headless runs read and write it only when
// given `--save`.

import std.io.{ read_bytes, write_bytes }
import bindings.sdl3.{
  init, quit, last_error, INIT_VIDEO, INIT_GAMEPAD,
  Window, create_window, destroy_window, set_fullscreen, WINDOW_RESIZABLE,
  Renderer, Rect, rgb, create_renderer, destroy_renderer, set_logical_presentation,
  PRESENT_INTEGER_SCALE, set_vsync, set_draw_color, clear, present, save_screenshot,
  Texture, create_streaming_texture, update_texture, destroy_texture, draw_texture,
  set_default_scale_mode, SCALE_NEAREST,
  poll_event, KEY_ESCAPE, KEY_F,
  key_held, SCANCODE_UP, SCANCODE_DOWN, SCANCODE_LEFT, SCANCODE_RIGHT, SCANCODE_Z,
  SCANCODE_X, SCANCODE_C, SCANCODE_A, SCANCODE_S, SCANCODE_D, SCANCODE_Q, SCANCODE_RETURN,
  Gamepad, open_gamepad, close_gamepad, gamepad_id, gamepad_button, gamepad_axis,
  BUTTON_DPAD_UP, BUTTON_DPAD_DOWN, BUTTON_DPAD_LEFT, BUTTON_DPAD_RIGHT, BUTTON_WEST,
  BUTTON_SOUTH, BUTTON_EAST, BUTTON_NORTH, BUTTON_LEFT_SHOULDER, BUTTON_RIGHT_SHOULDER,
  BUTTON_START, BUTTON_BACK, AXIS_LEFT_X, AXIS_LEFT_Y,
  ticks_ns,
  INIT_AUDIO, open_audio, close_audio, put_audio, queued_frames,
}
import m68k.{ Cpu }
import genesis.{
  GenesisBus, genesis_bus, new_cpu, power_on, run_frame, new_mixer, mix_audio,
  rom_image, is_split_part, next_part_path, save_bytes, load_save, set_pads,
  PAD_UP, PAD_DOWN, PAD_LEFT, PAD_RIGHT, PAD_A, PAD_B, PAD_C, PAD_START,
  PAD_X, PAD_Y, PAD_Z, PAD_MODE,
}
import vdp.{ Frame, shown_frame }

/// An NTSC frame: 262 lines of 3420 master clocks at 53.693175 MHz, in nanoseconds.
const FRAME_NS: i64 = 16688154

/// The screen as the logical size SDL scales up: 40-cell mode's, which a 32-cell frame is
/// stretched across, as a television did.
const SCREEN_W: i32 = 320
const SCREEN_H: i32 = 224

/// The host's audio rate, and how much may wait in its queue before new sound is dropped
/// (a display faster than the console's rate otherwise lets it grow without end).
const AUDIO_RATE: i64 = 48000
const AUDIO_QUEUE_LIMIT: i64 = 6000

let main = () -> u8 => {
  let args = program_args()
  if args.len() < 2 {
    println("usage: sheliak ROM [PART …] [--pads 3] [--frames N] [--screenshot FILE] [--ppm FILE] [--wav FILE] [--save]")
    return 2
  }
  var paths = [args[1]]
  var frames_only: i64 = -1
  var screenshot = ""
  var ppm = ""
  var wav = ""
  var headless_save = false
  var six_button = true
  var i = 2
  for i < args.len() {
    if args[i] == "--frames" && i + 1 < args.len() {
      frames_only = parse_count(args[i + 1])
      i += 2
    } else if args[i] == "--screenshot" && i + 1 < args.len() {
      screenshot = args[i + 1]
      i += 2
    } else if args[i] == "--ppm" && i + 1 < args.len() {
      ppm = args[i + 1]
      i += 2
    } else if args[i] == "--pads" && i + 1 < args.len() {
      six_button = args[i + 1] != "3"
      i += 2
    } else if args[i] == "--save" {
      headless_save = true
      i += 1
    } else if args[i] == "--wav" && i + 1 < args.len() {
      wav = args[i + 1]
      i += 2
    } else if !args[i].starts_with("--") {
      paths.push(args[i])
      i += 1
    } else {
      println("sheliak: unknown argument ${args[i]}")
      return 2
    }
  }
  let Some(files) = read_rom_files(paths) else { return 1 }
  let rom = match rom_image(files) {
    Ok(image) => image,
    Err(why) => {
      println("sheliak: ${args[1]} is ${why}")
      return 1
    },
  }
  if !init(INIT_VIDEO | INIT_GAMEPAD) {
    println("sheliak: SDL_Init failed: ${last_error()}")
    return 1
  }
  let Some(window) = create_window(
    "Sheliak",
    SCREEN_W * 3,
    SCREEN_H * 3,
    WINDOW_RESIZABLE
  ) else {
    println("sheliak: cannot open a window: ${last_error()}")
    quit()
    return 1
  }
  let Some(renderer) = create_renderer(window) else {
    println("sheliak: cannot make a renderer: ${last_error()}")
    destroy_window(window)
    quit()
    return 1
  }
  set_logical_presentation(renderer, SCREEN_W, SCREEN_H, PRESENT_INTEGER_SCALE)
  set_default_scale_mode(renderer, SCALE_NEAREST)
  set_vsync(renderer, frames_only < 0)
  var cpu = new_cpu()
  var bus = genesis_bus(rom)
  set_pads(bus, six_button)
  power_on(cpu, bus)
  let save_path = save_file_for(args[1])
  let saving = frames_only < 0 || headless_save
  if saving && bus.cart.save.len() > 0 {
    if let Some(saved) = read_bytes(save_path) { load_save(bus.cart, saved) }
  }
  let status = if frames_only >= 0 {
    run_headless(cpu, bus, renderer, frames_only, screenshot, ppm, wav)
  } else {
    play(cpu, bus, renderer, window, save_path)
  }
  if saving { write_save(bus, save_path) }
  destroy_renderer(renderer)
  destroy_window(window)
  quit()
  status
}

/// The files of a dump, read: those given, and when only the first part of a split SMD
/// image is, the parts after it, by the names they are guessed to have. `None`, having
/// said why, if one cannot be read.
let read_rom_files = (paths: []string) -> Maybe<[][]u8> => {
  var files: [][]u8 = []
  for path in paths {
    let Some(file) = read_bytes(path) else {
      println("sheliak: cannot read ${path}")
      return None
    }
    files.push(file)
  }
  if paths.len() > 1 { return Some(files) }
  var path = paths[0]
  for files.len() < MAX_PARTS && is_split_part(files[files.len() - 1]) {
    let Some(next) = next_part_path(path) else {
      println("sheliak: ${path} is one part of a split SMD image; give its parts in order")
      return None
    }
    let Some(file) = read_bytes(next) else {
      println("sheliak: ${path} is one part of a split SMD image, and its next part, ${next}, cannot be read; give its parts in order")
      return None
    }
    files.push(file)
    path = next
  }
  Some(files)
}

/// Parts looked for by name, at most: a guess that goes astray stops here.
const MAX_PARTS: i64 = 16

/// Run `frames` frames as fast as they go, show the last, and save it if asked.
let run_headless = (
  cpu: mut Cpu,
  bus: mut GenesisBus,
  renderer: Renderer,
  frames: i64,
  screenshot: string,
  ppm: string,
  wav: string
) -> u8 => {
  var mixer = new_mixer(AUDIO_RATE)
  var sound: []f32 = []
  for _ in 0..<frames {
    run_frame(cpu, bus)
    let samples = mix_audio(bus, mixer)
    if wav != "" {
      for v in samples { sound.push(v) }
    }
  }
  if wav != "" && !write_bytes(wav, wav_file(sound)) {
    println("sheliak: cannot write ${wav}")
    return 1
  }
  var screen = new_screen()
  show(renderer, screen, shown_frame(bus.vdp))
  let saved = screenshot == "" || save_screenshot(renderer, screenshot)
  present(renderer)
  let dumped = ppm == "" || write_bytes(ppm, texels_ppm(screen))
  release_screen(screen)
  if !saved {
    println("sheliak: cannot save ${screenshot}: ${last_error()}")
    return 1
  }
  if !dumped {
    println("sheliak: cannot write ${ppm}")
    return 1
  }
  0
}

/// The screen's texels as a binary PPM, red, green, blue a pixel.
let texels_ppm = pure (screen: Screen) -> []u8 => {
  var bytes: []u8 = []
  for c in "P6\n${screen.width} ${screen.height}\n255\n" { bytes.push(u8(i64(c))) }
  for t in screen.texels {
    bytes.push(u8((t >> 16) & 0xFF))
    bytes.push(u8((t >> 8) & 0xFF))
    bytes.push(u8(t & 0xFF))
  }
  bytes
}

/// Play until the window closes or Escape: frames run at the console's rate — however many
/// are due since the last look, so a display faster or slower than 59.92 Hz neither speeds
/// the game up nor slows it down — and the latest shown.
let play = (
  cpu: mut Cpu,
  bus: mut GenesisBus,
  renderer: Renderer,
  window: Window,
  save_path: string
) -> u8 => {
  var frames_since_save: i64 = 0
  var screen = new_screen()
  var mixer = new_mixer(AUDIO_RATE)
  // No audio device (or none SDL can open) is no sound, not no emulator.
  let stream = if init(INIT_AUDIO) { open_audio(i32(AUDIO_RATE), 2) } else { None }
  var pads: []Gamepad = []
  var fullscreen = false
  var last = i64(ticks_ns())
  var owed: i64 = 0
  var running = true
  for running {
    for {
      let Some(event) = poll_event() else { break }
      match event {
        Quit => { running = false },
        KeyDown(key) => {
          if key == KEY_ESCAPE { running = false }
          if key == KEY_F {
            fullscreen = !fullscreen
            set_fullscreen(window, fullscreen)
          }
        },
        GamepadAdded(id) => {
          if let Some(pad) = open_gamepad(id) { pads.push(pad) }
        },
        GamepadRemoved(id) => { pads = drop_gamepad(pads, id) },
        _ => {},
      }
    }
    bus.pads[0] = keyboard_buttons() | (if pads.len() > 0 { gamepad_buttons(pads[0]) } else { 0 })
    bus.pads[1] = if pads.len() > 1 { gamepad_buttons(pads[1]) } else { 0 }
    let now = i64(ticks_ns())
    owed += now - last
    last = now
    // After a stall (a window drag, a breakpoint) the lost time is forgiven, not raced.
    if owed > 4 * FRAME_NS { owed = FRAME_NS }
    for owed >= FRAME_NS {
      run_frame(cpu, bus)
      owed -= FRAME_NS
      frames_since_save += 1
    }
    if frames_since_save >= 600 {
      write_save(bus, save_path)
      frames_since_save = 0
    }
    let samples = mix_audio(bus, mixer)
    if let Some(s) = stream {
      if queued_frames(s) < AUDIO_QUEUE_LIMIT { put_audio(s, samples) }
    }
    show(renderer, screen, shown_frame(bus.vdp))
    present(renderer)
  }
  for pad in pads { close_gamepad(pad) }
  if let Some(s) = stream { close_audio(s) }
  release_screen(screen)
  0
}

// ── Saves ────────────────────────────────────────────────────────────────────

/// The cartridge's save RAM to its file, if the game has changed it since it was last
/// written.
let write_save = (bus: mut GenesisBus, path: string) -> void => {
  if !bus.cart.save_dirty { return }
  if write_bytes(path, save_bytes(bus.cart)) {
    bus.cart.save_dirty = false
  } else {
    println("sheliak: cannot write ${path}")
  }
}

/// The save file beside a ROM: its name with the extension replaced by `.srm`.
let save_file_for = pure (rom_path: string) -> string => {
  var dot = -1
  var i: i64 = 0
  for c in rom_path {
    if c == '.' { dot = i }
    if c == '/' { dot = -1 }
    i += 1
  }
  let stem = if dot > 0 { rom_path.slice(0, dot) } else { rom_path }
  stem ++ ".srm"
}

/// Stereo samples, -1 to 1, as a 16-bit PCM WAV file at the audio rate.
let wav_file = (samples: []f32) -> []u8 => {
  let data_bytes = samples.len() * 2
  var bytes: []u8 = []
  for c in "RIFF" { bytes.push(u8(i64(c))) }
  put_le(bytes, 36 + data_bytes, 4)
  for c in "WAVEfmt " { bytes.push(u8(i64(c))) }
  put_le(bytes, 16, 4)
  put_le(bytes, 1, 2)
  put_le(bytes, 2, 2)
  put_le(bytes, AUDIO_RATE, 4)
  put_le(bytes, AUDIO_RATE * 4, 4)
  put_le(bytes, 4, 2)
  put_le(bytes, 16, 2)
  for c in "data" { bytes.push(u8(i64(c))) }
  put_le(bytes, data_bytes, 4)
  for v in samples { put_le(bytes, (f64(v) * 32767.0).round() & 0xFFFF, 2) }
  bytes
}

/// `value`'s low `count` bytes, least significant first.
let put_le = (bytes: mut []u8, value: i64, count: i64) -> void => {
  for k in 0..<count { bytes.push(u8((value >> (8 * k)) & 0xFF)) }
}

// ── The picture ──────────────────────────────────────────────────────────────

/// A streaming texture the size of the frames going into it, and a buffer of texels to
/// fill it from.
struct Screen {
  texture: Maybe<Texture>,
  texels: []u32,
  width: i64,
  height: i64,
  /// Every VDP pixel value's colour ([pixel_color]), looked up rather than computed.
  colors: []u32,
}

let new_screen = pure () -> Screen => Screen {
  texture: None,
  texels: [],
  width: 0,
  height: 0,
  colors: [p in 0..<0x4000 | pixel_color(u16(p))],
}

let release_screen = (screen: Screen) -> void => {
  if let Some(texture) = screen.texture { destroy_texture(texture) }
}

/// Draw `frame` over the whole logical screen, a new texture made first if its size
/// changed.
let show = (renderer: Renderer, screen: mut Screen, frame: Frame) -> void => {
  if frame.width != screen.width || frame.height != screen.height {
    if let Some(old) = screen.texture { destroy_texture(old) }
    screen.texture = create_streaming_texture(renderer, frame.width, frame.height)
    screen.texels = [0; frame.width * frame.height]
    screen.width = frame.width
    screen.height = frame.height
  }
  for i, p in frame.pixels { screen.texels[i] = screen.colors[i64(p & 0x3FFF)] }
  set_draw_color(renderer, rgb(0, 0, 0))
  clear(renderer)
  let Some(texture) = screen.texture else { return }
  update_texture(texture, screen.texels)
  let whole = Rect { x: 0.0, y: 0.0, w: f32(frame.width), h: f32(frame.height) }
  let screen_rect = Rect { x: 0.0, y: 0.0, w: f32(SCREEN_W), h: f32(SCREEN_H) }
  draw_texture(renderer, texture, whole, screen_rect)
}

/// The DAC's 15 measured levels: a component c (0–7) is level 2c at normal intensity, c in
/// shadow, c + 7 in highlight — the same light `tests/frame_compare.py` compares.
const LEVELS: [15]u32 = #[
  0, 27, 49, 71, 87, 103, 119, 130,
  146, 157, 174, 190, 206, 228, 255,
]

/// A VDP pixel (a CRAM colour, `----bbb-ggg-rrr-`, and its intensity in bits 13–12) as
/// `0x00RRGGBB`.
let pixel_color = pure (pixel: u16) -> u32 => {
  let intensity = (pixel >> 12) & 3
  var rgb_value: u32 = 0
  for shift in [1, 5, 9] {
    let c = i64((pixel >> u16(shift)) & 7)
    let level = if intensity == 2 { LEVELS[c + 7] } else if intensity == 1 { LEVELS[c] } else { LEVELS[2 * c] }
    // Red (bits 3–1) is the texel's high byte, blue (11–9) its low.
    rgb_value = rgb_value | (level << u32(16 - (shift / 4) * 8))
  }
  rgb_value
}

// ── The pads ─────────────────────────────────────────────────────────────────

/// Pad 1's buttons held on the keyboard, by key position.
let keyboard_buttons = () -> u16 => {
  var held: u16 = 0
  if key_held(SCANCODE_UP) { held = held | PAD_UP }
  if key_held(SCANCODE_DOWN) { held = held | PAD_DOWN }
  if key_held(SCANCODE_LEFT) { held = held | PAD_LEFT }
  if key_held(SCANCODE_RIGHT) { held = held | PAD_RIGHT }
  if key_held(SCANCODE_Z) { held = held | PAD_A }
  if key_held(SCANCODE_X) { held = held | PAD_B }
  if key_held(SCANCODE_C) { held = held | PAD_C }
  if key_held(SCANCODE_A) { held = held | PAD_X }
  if key_held(SCANCODE_S) { held = held | PAD_Y }
  if key_held(SCANCODE_D) { held = held | PAD_Z }
  if key_held(SCANCODE_RETURN) { held = held | PAD_START }
  if key_held(SCANCODE_Q) { held = held | PAD_MODE }
  held
}

/// A gamepad's buttons as a Genesis pad's: the d-pad or the left stick past a third of its
/// travel; West, South and East for A, B and C; the left shoulder, North and the right
/// shoulder for X, Y and Z; Start, and Back for Mode.
let gamepad_buttons = (pad: Gamepad) -> u16 => {
  let x = i64(gamepad_axis(pad, AXIS_LEFT_X))
  let y = i64(gamepad_axis(pad, AXIS_LEFT_Y))
  var held: u16 = 0
  if gamepad_button(pad, BUTTON_DPAD_UP) || y < -STICK { held = held | PAD_UP }
  if gamepad_button(pad, BUTTON_DPAD_DOWN) || y > STICK { held = held | PAD_DOWN }
  if gamepad_button(pad, BUTTON_DPAD_LEFT) || x < -STICK { held = held | PAD_LEFT }
  if gamepad_button(pad, BUTTON_DPAD_RIGHT) || x > STICK { held = held | PAD_RIGHT }
  if gamepad_button(pad, BUTTON_WEST) { held = held | PAD_A }
  if gamepad_button(pad, BUTTON_SOUTH) { held = held | PAD_B }
  if gamepad_button(pad, BUTTON_EAST) { held = held | PAD_C }
  if gamepad_button(pad, BUTTON_LEFT_SHOULDER) { held = held | PAD_X }
  if gamepad_button(pad, BUTTON_NORTH) { held = held | PAD_Y }
  if gamepad_button(pad, BUTTON_RIGHT_SHOULDER) { held = held | PAD_Z }
  if gamepad_button(pad, BUTTON_START) { held = held | PAD_START }
  if gamepad_button(pad, BUTTON_BACK) { held = held | PAD_MODE }
  held
}

/// A third of the stick's travel.
const STICK: i64 = 11000

/// The gamepads still plugged in, `id` closed.
let drop_gamepad = (pads: []Gamepad, id: u32) -> []Gamepad => {
  var kept: []Gamepad = []
  for pad in pads {
    if gamepad_id(pad) == id { close_gamepad(pad) } else { kept.push(pad) }
  }
  kept
}

/// A decimal count, or -1 if `text` is not one.
let parse_count = pure (text: string) -> i64 => {
  var n: i64 = 0
  for c in text {
    if c < '0' || c > '9' { return -1 }
    n = n * 10 + (i64(c) - i64('0'))
  }
  n
}
